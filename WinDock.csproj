<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinDock</AssemblyName>
    <RootNamespace>WinDock</RootNamespace>

    <!-- icone do executavel: e o que o Explorer, o Alt+Tab e a chave Run mostram -->
    <ApplicationIcon>assets\windock.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      tests/ tem projeto proprio (tests/TreeCheck). Sem isto, o glob recursivo do SDK puxaria os
      .cs de la para dentro da dock: dois Program, e o LayoutTree.cs contado duas vezes.
    -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- o mesmo arquivo embutido, para as janelas do app poderem usa-lo -->
    <Resource Include="assets\windock.ico" />

    <!-- a arte grande: num .ico o WPF escolhe um quadro pequeno e estica -->
    <Resource Include="assets\windock.png" />

    <!-- o histórico de versões, lido pela página "Notas da versão" (src/Services/ReleaseNotes.cs) -->
    <EmbeddedResource Include="docs\NOTAS.md" LogicalName="WinDock.NOTAS.md" />
  </ItemGroup>

  <ItemGroup>
    <!--
      O App.xaml mora em src/ junto com o resto do codigo, e o SDK do WPF so o reconhece
      sozinho quando esta na raiz. Sem estas linhas ele seria compilado como uma Page comum
      e o build nao acharia o ponto de entrada da aplicacao.
    -->
    <ApplicationDefinition Remove="App.xaml" />
    <ApplicationDefinition Include="src\App.xaml" />
    <Page Remove="src\App.xaml" />
  </ItemGroup>

  <!--
    A versão do build local, pela mesma regra do CI (.github/workflows/build.yml): a tag mais
    recente no formato 1.0.0.N, e "-dev.N" quando há commits depois dela. Sem isto a dock de dist
    saía 1.0.0.0 e não tinha como saber se a Release do GitHub é mais nova que ela — que é o que
    acende o ícone de "nova versão do WinDock". No CI a versão já vem por parâmetro, e este passo
    fica de fora; sem git ou sem tag, nada muda.

    Roda num target, e não em propriedade: o SDK calcula Version ao avaliar o projeto, antes de
    qualquer comando, então aqui as quatro versões são definidas direto, antes de virarem atributo.
  -->
  <Target Name="WinDockVersaoPeloGit" BeforeTargets="GetAssemblyAttributes"
          Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <Exec Command="git describe --tags --abbrev=0 --match &quot;[0-9]*.[0-9]*.[0-9]*.[0-9]*&quot;"
          ConsoleToMsBuild="true" StandardOutputImportance="low" StandardErrorImportance="low"
          IgnoreExitCode="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_WdTag" />
      <Output TaskParameter="ExitCode" PropertyName="_WdTagSaida" />
    </Exec>

    <Exec Command="git rev-list --count $(_WdTag)..HEAD" Condition="'$(_WdTagSaida)' == '0'"
          ConsoleToMsBuild="true" StandardOutputImportance="low" StandardErrorImportance="low"
          IgnoreExitCode="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_WdCommits" />
    </Exec>

    <PropertyGroup Condition="'$(_WdTagSaida)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_WdTag)', '^\d+\.\d+\.\d+\.\d+$'))">
      <Version>$(_WdTag)</Version>
      <Version Condition="'$(_WdCommits)' != '' and '$(_WdCommits)' != '0'">$(_WdTag)-dev.$(_WdCommits)</Version>
      <AssemblyVersion>$(_WdTag)</AssemblyVersion>
      <FileVersion>$(_WdTag)</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
