<Window x:Class="WinDock.NotificationBalloon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinDock.Ui"
        Title="WinDock" ShowInTaskbar="False" ShowActivated="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" SizeToContent="Height" Width="320"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <!--
    O balão breve de uma notificação que acabou de chegar, embaixo do sino. Mesmo desenho e mesma
    regra do balão de lembrete: janela nossa, que não rouba o foco de quem está escrevendo.

    O balão inteiro é o clique que leva a quem mandou, como a notificação no cartão do sino; o ✕
    só fecha. Some sozinho depois do tempo das Configurações, e espera enquanto o mouse está em
    cima — ninguém lê uma mensagem que foge debaixo do cursor.
  -->

  <Border x:Name="Face" Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="10"
          Padding="12,10" Margin="10" Cursor="Hand" MouseLeftButtonUp="OnOpen">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
    </Border.Effect>

    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid VerticalAlignment="Center" Margin="0,0,7,0">
          <Image x:Name="AppIcon" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality" />
          <ui:GlyphIcon x:Name="Glyph" Size="13" Weight="0.4" />
        </Grid>
        <TextBlock Grid.Column="1" x:Name="Source" Foreground="#FF9D9D9D" FontSize="11"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

        <Border Grid.Column="2" x:Name="CloseBox" Background="Transparent" CornerRadius="5" Padding="6,1"
                MouseLeftButtonUp="OnClose" ToolTip="Fechar">
          <TextBlock Text="✕" Foreground="#FF8A8A8A" FontSize="10" />
        </Border>
      </Grid>

      <TextBlock x:Name="Heading" Foreground="#FFF2F2F2" FontSize="13" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
      <TextBlock x:Name="Body" Foreground="#FFC8C8C8" FontSize="12" TextWrapping="Wrap"
                 TextTrimming="CharacterEllipsis" MaxHeight="50" Margin="0,2,0,0" />
    </StackPanel>
  </Border>
</Window>
