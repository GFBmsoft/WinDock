<Window x:Class="WinDock.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock" Icon="/assets/windock.ico"
        SizeToContent="Height" Width="450"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DialogSurface}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <!--
    A caixa de diálogo no desenho do Windows 11: barra de título do sistema, instrução
    principal em corpo grande, explicação abaixo, e os botões numa faixa própria no rodapé —
    o primeiro deles é o que a tecla Enter aciona.

    As cores vêm por DynamicResource porque são decididas em tempo de execução: esta janela
    segue o tema do Windows (veja o WindowsTheme), e não a paleta escura da dock.
  -->

  <Window.Resources>

    <!-- botão comum: fundo de controle, borda de um pixel, canto de 4 px -->
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="118" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource DialogText}" />
      <Setter Property="Background" Value="{DynamicResource DialogControl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DialogControlBorder}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background"
                        Value="{DynamicResource DialogControlHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- botão da ação principal: pintado com a cor de destaque do Windows -->
    <Style x:Key="DialogAccentButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="Foreground" Value="{DynamicResource DialogOnAccent}" />
      <Setter Property="Background" Value="{DynamicResource DialogAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DialogAccent}" />
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="24,22,24,24">
      <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                 Foreground="{DynamicResource DialogText}" />
      <TextBlock x:Name="Body" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"
                 LineHeight="20" Foreground="{DynamicResource DialogTextDim}" />
    </StackPanel>

    <!-- a faixa do rodapé é o que dá à caixa a silhueta das do Windows 11 -->
    <Border Grid.Row="1" Background="{DynamicResource DialogFooter}"
            BorderBrush="{DynamicResource DialogDivider}" BorderThickness="0,1,0,0"
            Padding="24,20">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="AcceptButton" Click="OnAccept" IsDefault="True"
                Style="{StaticResource DialogAccentButton}" Margin="0,0,8,0" />
        <Button x:Name="CancelBtn" Click="OnCancel" IsCancel="True"
                Style="{StaticResource DialogButton}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
