<Window x:Class="WinDock.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock" ShowInTaskbar="False" ShowActivated="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" SizeToContent="Height" Width="320"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <!--
    O balão de lembrete: a hora de uma tarefa chegou.

    É uma janela nossa, e não uma notificação do Windows: o toast do sistema exige que o
    programa esteja registrado com um AppUserModelID e tenha atalho no Menu Iniciar, e a dock
    roda de uma pasta, sem instalação. Além disso o toast cairia na Central de Notificações do
    Windows, que é justamente o lugar onde ninguém olha.

    Nasce sem roubar o foco (ShowActivated e, no código, WS_EX_NOACTIVATE): um aviso que tira o
    cursor de quem está escrevendo é pior que o esquecimento que ele evita.
  -->

  <Window.Resources>
    <Style x:Key="BalloonButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="10"
          Padding="14,12" Margin="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
    </Border.Effect>

    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Heading" Foreground="#FF4CC2FF" FontSize="11" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Style="{StaticResource BalloonButton}" Click="OnDismiss" Padding="6,2"
                ToolTip="Fechar">
          <TextBlock Text="✕" Foreground="#FF8A8A8A" FontSize="11" />
        </Button>
      </Grid>

      <TextBlock x:Name="Body" Foreground="#FFF2F2F2" FontSize="14" TextWrapping="Wrap"
                 Margin="0,6,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Style="{StaticResource BalloonButton}" Click="OnSnooze" ToolTip="Avisar de novo em 10 minutos">
          <TextBlock Text="Adiar 10 min" Foreground="#FFC5C5C5" FontSize="12" />
        </Button>
        <Button Style="{StaticResource BalloonButton}" Click="OnDone" Margin="4,0,0,0">
          <TextBlock Text="Feito" Foreground="#FF6CCB5F" FontSize="12" FontWeight="SemiBold" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
