<Window x:Class="WinDock.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinDock.Ui"
        xmlns:views="clr-namespace:WinDock.Views"
        Title="WinDock Panel"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <!--
    A barra de cima: o relogio que se perde ao esconder a barra do Windows, mais os
    indicadores e os atalhos para os paineis do proprio Windows. Os icones de wi-fi e de
    volume sao os glifos da Segoe Fluent Icons — a fonte que o Windows 11 usa na barra
    dele —, e a bateria e desenhada aqui para poder mostrar o nivel dentro da pilha.
  -->

  <Window.Resources>

    <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    <!-- os campos de texto do cartão do calendário, escuros como o cartão (o TextBox do WPF viria
         branco) -->
    <Style x:Key="CalendarField" TargetType="TextBox">
      <Setter Property="Background" Value="#FF2D2D2D" />
      <Setter Property="Foreground" Value="#FFF2F2F2" />
      <Setter Property="CaretBrush" Value="#FFF2F2F2" />
      <Setter Property="SelectionBrush" Value="#FF4CC2FF" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <ui:BoolToCollapsed x:Key="BoolToCollapsed" />
    <ui:UsageBrush x:Key="UsageBrush" />
    <ui:EmptyToCollapsed x:Key="EmptyToCollapsed" />
    <ui:ResetText x:Key="ResetText" />
    <ui:HexBrushConverter x:Key="HexBrush" />

    <Style x:Key="PanelButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#FFE8E8EA" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="9,2" Margin="1,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <!-- ícones compactos: metade do respiro, o mesmo desenho. A busca vai à janela, e
                   não ao DataContext do botão, porque os ícones da bandeja têm o item como
                   contexto -->
              <DataTrigger Binding="{Binding DataContext.PanelCompact,
                                     RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="Bg" Property="Padding" Value="5,2" />
                <Setter TargetName="Bg" Property="Margin" Value="0" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- o desenho dos ícones da barra: 15 px, e 12 com os ícones compactos. Só o espaço não
         bastava — sem mudar o tamanho, wi-fi, bluetooth e sino continuavam parecendo os mesmos
         ao lado do processador e da memória, que têm 11 -->
    <Style x:Key="BarGlyph" TargetType="ui:GlyphIcon">
      <Setter Property="Size" Value="15" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding DataContext.PanelCompact,
                               RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="Size" Value="12" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- o relógio e a data: mesmo realce dos outros botões, sem o respiro largo deles -->
    <Style x:Key="ClockButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="6,2">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
              </Trigger>
              <DataTrigger Binding="{Binding DataContext.PanelCompact,
                                     RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="Bg" Property="Padding" Value="4,2" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- O texto miúdo da barra: os números de CPU e memória (o relógio segue o mesmo modo).

         A janela inteira desenha texto no modo Ideal, que é o certo para os cartões — e é o que
         deixa 11 px serrilhado aqui: sem ClearType (a barra é uma janela transparente, então o
         WPF cai para tons de cinza), as letras ficam entre dois pixels e a borda sai picotada.
         O modo Display encaixa cada traço na grade de pixels: em 11 px é a diferença entre
         "13:15" nítido e borrado. Medido lado a lado em 01/10/2026. -->
    <Style x:Key="BarText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFE8E8EA" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- data e hora na barra: 13 px em seminegrito, e nos ícones compactos 11 px, o tamanho dos
         números de CPU e memória (o BarText, acima). Em 11 px o seminegrito fica: regular, no
         modo Display, o traço ficava fino demais para ler de relance (pedido de 01/10/2026) -->
    <Style x:Key="ClockText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFF2F2F2" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding DataContext.PanelCompact,
                               RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="FontSize" Value="11" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- um ícone da bandeja: quadrado e apertado, para caber vários sem esticar a barra -->
    <Style x:Key="TrayButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="4,3" Margin="1,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- um ícone dentro do cartão da bandeja: quadrado, com folga para o dedo -->
    <Style x:Key="TrayCardButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Width="40" Height="40"
                    Margin="1">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- uma linha dos painéis: ícone à esquerda, texto, realce seguindo o mouse -->
    <Style x:Key="PanelRow" TargetType="Button" BasedOn="{StaticResource PanelButton}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,7" Margin="0,1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a mesma linha, com metade do respiro: a do cartão de ferramentas, que é lista de atalhos -->
    <Style x:Key="PanelRowCompact" TargetType="Button" BasedOn="{StaticResource PanelRow}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="6,3">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PanelGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="#FFF2F2F2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

  </Window.Resources>

  <Border Background="{Binding PanelBrush}">
    <Grid Margin="12,0">

      <!-- relogio no meio, quando a opção estiver ligada -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding ClockCentered, Converter={StaticResource BoolToVisible}}">
        <Button x:Name="CenterDateButton" Style="{StaticResource ClockButton}" Click="OnCalendar"
                ToolTip="Calendário">
          <TextBlock Text="{Binding Date}" Style="{StaticResource ClockText}" />
        </Button>
        <Button x:Name="CenterTimeButton" Style="{StaticResource ClockButton}" Click="OnClock"
                ToolTip="Hora com segundos">
          <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" />
        </Button>
      </StackPanel>

      <!-- Canto direito: bandeja, mídia, bateria, wi-fi, som, notificações e (fora do modo
           centralizado) o relógio.

           A ordem daqui é só a inicial: cada item carrega uma chave no `Tag`, e a janela
           reordena estes filhos no arranque conforme `DockConfig.PanelOrder` (veja
           `ApplyPanelOrder`). Quem mexer aqui só define o padrão de quem nunca customizou —
           e ao acrescentar um item novo, dê a ele um `Tag` e um nome em `PanelItems`, senão
           ele fica de fora da lista das opções. -->
      <StackPanel x:Name="RightItems" Orientation="Horizontal"
                  HorizontalAlignment="Right" VerticalAlignment="Center">

        <!-- a bandeja: com a barra do Windows escondida, é aqui que o antivírus e os
             programas que só vivem na bandeja continuam alcançáveis. A seta abre um cartão
             com os ícones, como o "mostrar ícones ocultos" do Windows — e abri-lo relê a
             bandeja, porque só o painel do Windows sabe o que está lá agora. -->
        <Button Tag="bandeja" x:Name="TrayButton" Style="{StaticResource TrayButton}" Click="OnToggleTray"
                MouseLeave="OnTrayButtonLeave"
                Margin="0,0,6,0" ToolTip="{Binding TrayTooltip}"
                Visibility="{Binding ShowTray, Converter={StaticResource BoolToVisible}}">
          <ui:GlyphIcon Glyph="{Binding TrayGlyph}" Fill="#FFC8C8CC" Size="11"
                        VerticalAlignment="Center" />
        </Button>

        <!-- O que está tocando, com os controles na própria barra. O bloco inteiro some
             quando não há mídia (ShowMedia) — foi o pedido: item parado o dia inteiro pesa
             mais que o deslocamento dos vizinhos quando a música começa. -->
        <Button Tag="midia" x:Name="MediaButton" Style="{StaticResource ClockButton}" Click="OnMedia"
                ToolTip="{Binding Media.Summary}"
                Visibility="{Binding ShowMedia, Converter={StaticResource BoolToVisible}}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- a capa em miniatura faz o papel do logo do app na referência, e diz de que
                 faixa se trata antes mesmo de ler o texto -->
            <Border Width="16" Height="16" CornerRadius="3" Background="#22FFFFFF"
                    VerticalAlignment="Center" Margin="0,0,7,0">
              <Image Source="{Binding Media.Cover}" Stretch="UniformToFill"
                     RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- Os chevrons ficam FORA do texto que trunca, e não como Run dentro dele: com
                 tudo no mesmo TextBlock, uma faixa de nome longo levava o "❯" junto nas
                 reticências e o par ficava aberto sem fechar. -->
            <TextBlock Text="&#x276E;" Foreground="#FF8A8A8A" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,5,0" />

            <!-- O nome da faixa rolando quando nÃ£o cabe: a moldura recorta e quem anda Ã© o
                 texto dentro dela. A largura e a animaÃ§Ã£o sÃ£o calculadas no cÃ³digo â sÃ³ lÃ¡
                 se sabe quanto o texto mede de verdade. Veja `UpdateMediaTicker`.

                 Com a opÃ§Ã£o desligada (ou com o texto cabendo), nada disso entra em cena e o
                 TextBlock volta a ser o de sempre, com as reticÃªncias do WPF. -->
            <Border x:Name="MediaClip" MaxWidth="220" ClipToBounds="True" VerticalAlignment="Center">
              <TextBlock x:Name="MediaText" Text="{Binding Media.Summary}" Foreground="#FFE8E8EA"
                         FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                <TextBlock.RenderTransform>
                  <TranslateTransform x:Name="MediaSlide" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </Border>

            <TextBlock Text="&#x276F;" Foreground="#FF8A8A8A" FontSize="12"
                       VerticalAlignment="Center" Margin="5,0,0,0" />
          </StackPanel>
        </Button>
        <!-- Os controles, separados da informação da faixa por um respiro — a referência
             (EV19) os joga para o fim da barra, e assim ficou primeiro, mas na tela deste
             tamanho eles ficaram longe demais do que controlam. Ao lado da bateria mantêm a
             separação visual e continuam perto da faixa. -->
        <StackPanel Tag="midia-controles" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                    Visibility="{Binding ShowMedia, Converter={StaticResource BoolToVisible}}">

          <Button Style="{StaticResource PanelButton}" Click="OnMediaPrevious" Padding="4,2"
                  IsEnabled="{Binding Media.CanPrevious}" ToolTip="Faixa anterior">
            <ui:GlyphIcon Glyph="&#xE892;" Fill="#FFF2F2F2" Size="13" VerticalAlignment="Center" />
          </Button>

          <Button Style="{StaticResource PanelButton}" Click="OnMediaToggle" Padding="4,2"
                  ToolTip="Tocar ou pausar">
            <ui:GlyphIcon Glyph="{Binding MediaGlyph}" Fill="#FFF2F2F2" Size="14" VerticalAlignment="Center" />
          </Button>

          <Button Style="{StaticResource PanelButton}" Click="OnMediaNext" Padding="4,2"
                  IsEnabled="{Binding Media.CanNext}" ToolTip="Próxima faixa">
            <ui:GlyphIcon Glyph="&#xE893;" Fill="#FFF2F2F2" Size="13" VerticalAlignment="Center" />
          </Button>
        </StackPanel>


        <!-- Ferramentas: a chave de boca, com os comandos que a pessoa mais usa para mexer no
             Windows — limpeza de disco, gerenciador de dispositivos, área de trabalho remota.
             A lista é dela, montada nas Configurações (DockConfig.Tools). -->
        <Button Tag="ferramentas" x:Name="ToolsButton" Style="{StaticResource PanelButton}"
                Click="OnTools" ToolTip="Ferramentas"
                Visibility="{Binding HasTools, Converter={StaticResource BoolToVisible}}">
          <ui:GlyphIcon Glyph="&#xE90F;" Fill="#FFF2F2F2" Style="{StaticResource BarGlyph}" VerticalAlignment="Center" />
        </Button>

        <!-- Sistema: o processador e o pente de memória, com a porcentagem ao lado de cada
             um. As palavras "CPU" e "RAM" custariam o dobro da largura numa barra que já é
             disputada, e estes dois desenhos da Segoe são reconhecíveis em 12 px.

             Cada desenho tem a cor do gráfico dele no cartão: laranja o processador, lilás a
             memória. O processador já foi azul no gráfico, e mudou junto — azul é a cor das
             atualizações, que moram ao lado na barra, e os dois se confundiam.

             A rede **não** tem item próprio: ela vive no cartão, junto com estes dois. Dois
             números de velocidade, mudando a cada segundo, ocupavam mais espaço na barra do
             que qualquer outro item — e são justamente os que só se olha quando se está
             procurando por eles.

             As larguras são fixas de propósito. O número muda todo segundo, e com largura
             automática o item — e todos os vizinhos à esquerda dele — pulava de lugar a cada
             tique. Encostados à direita, os dígitos crescem para dentro do espaço que já
             estava reservado. Trinta pixels seriam folga: "100%" cabe em 26. -->
        <Button Tag="sistema" x:Name="SystemButton" Style="{StaticResource ClockButton}"
                Click="OnSystemStats" ToolTip="{Binding SystemTooltip}" Padding="4,2"
                Visibility="{Binding HasSystemInfo, Converter={StaticResource BoolToVisible}}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:GlyphIcon Glyph="&#xE950;" Fill="#FFF4A261" Size="11" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CpuText}" Style="{StaticResource BarText}" Width="26"
                       TextAlignment="Right" Margin="1,0,0,0" />
            <ui:GlyphIcon Glyph="&#xE964;" Fill="#FFB08AE8" Size="11" VerticalAlignment="Center"
                          Margin="5,0,0,0" />
            <TextBlock Text="{Binding RamText}" Style="{StaticResource BarText}" Width="26"
                       TextAlignment="Right" Margin="1,0,0,0" />
          </StackPanel>
        </Button>

        <!-- a pilha do Windows: corpo, ponta e o miolo que enche conforme a carga.
             A porcentagem fica na dica do mouse: o desenho ja diz o quanto resta. -->
        <!-- nos ícones compactos a pilha encolhe inteira, na proporção dos ícones (15 → 12), e
             o miolo vai junto — a escala é do desenho, não das medidas -->
        <StackPanel Tag="bateria" Orientation="Horizontal" VerticalAlignment="Center"
                    ToolTip="{Binding BatteryTooltip}"
                    Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisible}}">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Margin" Value="0,0,10,0" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding PanelCompact}" Value="True">
                  <Setter Property="Margin" Value="2,0,6,0" />
                  <Setter Property="LayoutTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Grid VerticalAlignment="Center">
            <Border Width="21" Height="11" CornerRadius="3"
                    BorderBrush="#FFB6B7BC" BorderThickness="1" />
            <Border Width="2" Height="5" CornerRadius="0,1,1,0" Background="#FFB6B7BC"
                    HorizontalAlignment="Right" Margin="0,0,-3,0" />
            <!-- branco como os outros ícones; vermelho abaixo de 20%, verde carregando -->
            <Border Height="7" CornerRadius="1.5" Margin="2,0,0,0" HorizontalAlignment="Left"
                    Width="{Binding BatteryFill}" Background="{Binding BatteryBrush}" />
          </Grid>
        </StackPanel>

        <Button Tag="wifi" Style="{StaticResource PanelButton}" Click="OnQuickSettings" ToolTip="Wi-Fi">
          <ui:GlyphIcon Glyph="{Binding WifiGlyph}" Fill="#FFF2F2F2" Style="{StaticResource BarGlyph}" VerticalAlignment="Center" />
        </Button>

        <!-- apagado quando o radio esta desligado; o clique abre a lista de aparelhos -->
        <Button Tag="bluetooth" x:Name="BluetoothButton" Style="{StaticResource PanelButton}" Click="OnBluetooth"
                ToolTip="{Binding BluetoothTooltip}" Opacity="{Binding BluetoothOpacity}">
          <ui:GlyphIcon Glyph="{Binding BluetoothGlyph}" Fill="#FFF2F2F2" Style="{StaticResource BarGlyph}" VerticalAlignment="Center" />
        </Button>

        <!-- Brilho: some sozinho num monitor que não fala DDC/CI (o painel de notebook, em
             geral). A roda ajusta sem abrir nada, como no volume. -->
        <Button Tag="brilho" x:Name="BrightnessButton" Style="{StaticResource PanelButton}"
                Click="OnBrightness" PreviewMouseWheel="OnBrightnessWheel"
                Visibility="{Binding HasBrightness, Converter={StaticResource BoolToVisible}}">
          <Button.ToolTip>
            <ToolTip x:Name="BrightnessTip" Content="Brilho — role para ajustar" />
          </Button.ToolTip>
          <ui:GlyphIcon Glyph="{Binding BrightnessGlyph}" Fill="#FFF2F2F2" Style="{StaticResource BarGlyph}" VerticalAlignment="Center" />
        </Button>
        <!-- Remover dispositivo externo: só existe enquanto houver pen-drive ou HD externo
             montado. O clique abre o cartão com a lista; remover é lá dentro, e não neste
             botão, porque com dois aparelhos espetados não há como o botão adivinhar qual. -->
        <Button Tag="remover" x:Name="RemovableButton" Style="{StaticResource PanelButton}"
                Click="OnRemovable" ToolTip="{Binding RemovableTooltip}"
                Visibility="{Binding HasRemovable, Converter={StaticResource BoolToVisible}}">
          <ui:GlyphIcon Glyph="{Binding RemovableGlyph}" Fill="#FFF2F2F2" Style="{StaticResource BarGlyph}" VerticalAlignment="Center" />
        </Button>

        <!-- Atualizações: aceso e com o número quando há algo esperando, apagado quando está tudo
             em dia. O número vai ao lado do ícone porque é ele que decide se vale interromper o que
             se está fazendo — "3" e "47" pedem coisas diferentes; e sem ele, apagado, o ícone ainda
             responde a outra pergunta, a de que a dock está conferindo. -->
        <!-- Nova versão do WinDock e atualizações do Windows formam um item só para a ordenação
             (a chave "atualizacoes" é do grupo): o presente fica sempre à esquerda da seta, para
             onde quer que a pessoa leve as duas. O presente só existe enquanto há Release nova. -->
        <StackPanel Tag="atualizacoes" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource PanelButton}" Click="OnSelfUpdate"
                  ToolTip="{Binding SelfUpdateTooltip}" AutomationProperties.Name="Nova versão do WinDock"
                  Visibility="{Binding HasSelfUpdate, Converter={StaticResource BoolToVisible}}">
            <ui:GlyphIcon Glyph="{Binding SelfUpdateGlyph}" Style="{StaticResource BarGlyph}"
                          VerticalAlignment="Center" Fill="#FF4CC2FF" />
          </Button>

          <Button x:Name="UpdatesButton" Style="{StaticResource PanelButton}"
                  Click="OnUpdates" ToolTip="{Binding UpdatesTooltip}"
                  Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisible}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:GlyphIcon Glyph="{Binding UpdatesGlyph}" Style="{StaticResource BarGlyph}" VerticalAlignment="Center"
                            Fill="{Binding UpdatesFill, Converter={StaticResource HexBrush}}" />
              <TextBlock Text="{Binding UpdatesCount}" Foreground="#FF4CC2FF" FontSize="11"
                         FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"
                         Visibility="{Binding UpdatesCount, Converter={StaticResource EmptyToCollapsed}}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Cota de IA: só aparece com a opção ligada e credencial do Claude Code na
             máquina. O clique abre o cartão com as janelas de uso. -->
        <Button Tag="cotaIa" x:Name="AiUsageButton" Style="{StaticResource PanelButton}"
                Click="OnAiUsage" ToolTip="{Binding AiTooltip}"
                Visibility="{Binding HasAiUsage, Converter={StaticResource BoolToVisible}}">
          <!-- a cor segue o medidor mais cheio: branco enquanto sobra, âmbar a partir de 60%,
               vermelho a partir de 90% — veja `PanelModel.AiBrush` -->
          <ui:GlyphIcon Glyph="{Binding AiGlyph}" Fill="{Binding AiBrush}" Style="{StaticResource BarGlyph}"
                        VerticalAlignment="Center" />
        </Button>

        <!-- a roda do mouse sobe e desce o volume, como na barra do Windows -->
        <Button Tag="volume" x:Name="VolumeButton" Style="{StaticResource PanelButton}" Click="OnVolume"
                PreviewMouseWheel="OnVolumeWheel">
          <!-- A dica é um objeto com nome, e não um texto solto, só para poder ser FECHADA
               ao rolar a roda. `ToolTipService.SetIsEnabled(false)` impede a próxima mas não
               tira da tela a que já está aberta — e ela sempre está, porque o cursor ficou
               parado sobre o ícone tempo suficiente para abri-la. O resultado era a dica
               aparecendo por baixo do mostrador, dois cartões empilhados. -->
          <Button.ToolTip>
            <ToolTip x:Name="VolumeTip" Content="Volume — role para ajustar" />
          </Button.ToolTip>
          <ui:GlyphIcon Glyph="{Binding VolumeGlyph}" Fill="#FFF2F2F2" Style="{StaticResource BarGlyph}" VerticalAlignment="Center" />
        </Button>

        <Button Tag="notificacoes" Style="{StaticResource PanelButton}" Click="OnNotifications"
                ToolTip="Notificações">
          <ui:GlyphIcon Glyph="{Binding BellGlyph}" Fill="#FFF2F2F2" Style="{StaticResource BarGlyph}" VerticalAlignment="Center" />
        </Button>

        <!-- energia: desligar, reiniciar, hibernar, bloquear e encerrar sessão -->
        <Button Tag="energia" x:Name="PowerButton" Style="{StaticResource PanelButton}" Click="OnPower"
                ToolTip="Desligar, reiniciar, bloquear">
          <ui:GlyphIcon Glyph="{Binding PowerGlyph}" Fill="#FFF2F2F2" Style="{StaticResource BarGlyph}" VerticalAlignment="Center" />
        </Button>

        <!-- o relogio do canto: some quando a opção o manda para o meio da barra -->
        <StackPanel Tag="relogio" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                    Visibility="{Binding ClockAtRight, Converter={StaticResource BoolToVisible}}">
          <Button x:Name="RightDateButton" Style="{StaticResource ClockButton}" Click="OnCalendar"
                  ToolTip="Calendário">
            <TextBlock Text="{Binding Date}" Style="{StaticResource ClockText}" />
          </Button>
          <Button x:Name="RightTimeButton" Style="{StaticResource ClockButton}" Click="OnClock"
                  ToolTip="Hora com segundos">
            <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" />
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- os aparelhos bluetooth, sem precisar abrir as configuracoes -->
      <Popup x:Name="BluetoothPopup" PlacementTarget="{Binding ElementName=BluetoothButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel Width="280">

            <!-- cabeçalho: o que é, e o estado do rádio à direita -->
            <Grid Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <ui:GlyphIcon Glyph="{Binding BluetoothGlyph}" Fill="#FFF2F2F2" Size="16"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Bluetooth" Foreground="#FFF2F2F2" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <!-- Interruptor no desenho do Windows: clicar alterna o rádio. A alça desliza
                   dentro do trilho (36 px de área interna, alça de 14 com 3 de folga de cada
                   lado, logo um percurso de 16). Enquanto o rádio muda de estado o botão
                   fica desabilitado, e a opacidade é o que mostra isso. -->
              <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                      Click="OnToggleBluetooth" IsEnabled="{Binding BluetoothReady}"
                      ToolTip="Ligar ou desligar o Bluetooth">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Trilho" Width="38" Height="20" CornerRadius="10"
                            Background="#00000000" BorderBrush="#8AFFFFFF" BorderThickness="1">
                      <Ellipse x:Name="Alca" Width="14" Height="14" Fill="#FFD8D8DA"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Margin="3,0,0,0">
                        <Ellipse.RenderTransform>
                          <TranslateTransform x:Name="Desliza" X="0" />
                        </Ellipse.RenderTransform>
                      </Ellipse>
                    </Border>

                    <ControlTemplate.Triggers>
                      <DataTrigger Binding="{Binding BluetoothOn}" Value="True">
                        <Setter TargetName="Trilho" Property="Background" Value="#FF3FA34D" />
                        <Setter TargetName="Trilho" Property="BorderBrush" Value="#FF3FA34D" />
                        <Setter TargetName="Alca" Property="Fill" Value="#FFFFFFFF" />
                        <DataTrigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="Desliza"
                                               Storyboard.TargetProperty="X"
                                               To="16" Duration="0:0:0.12" />
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="Desliza"
                                               Storyboard.TargetProperty="X"
                                               To="0" Duration="0:0:0.12" />
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.ExitActions>
                      </DataTrigger>

                      <!-- só a opacidade, que nenhum outro gatilho aqui disputa: mexer no
                           tamanho da alça desalinharia o percurso, e mexer no fundo perderia
                           para o verde do gatilho de cima -->
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Trilho" Property="Opacity" Value="0.82" />
                      </Trigger>

                      <!-- o rádio está mudando de estado: nada de um segundo clique. Vem por
                           último de propósito, para vencer o realce do mouse -->
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Trilho" Property="Opacity" Value="0.4" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding BluetoothDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- o realce segue o mouse, como nas listas do Windows -->
                  <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8,7" Margin="0,1">
                    <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- verde quando conectado de verdade, so contorno quando apenas pareado -->
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="#00000000" />
                          <Setter Property="Stroke" Value="#66FFFFFF" />
                          <Setter Property="StrokeThickness" Value="1" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Connected}" Value="True">
                              <Setter Property="Fill" Value="#FF6CCB5F" />
                              <Setter Property="Stroke" Value="#FF6CCB5F" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#FFE8E8EA"
                               FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                    <!-- só quem informa a bateria mostra esta coluna -->
                    <TextBlock Grid.Column="2" Text="{Binding BatteryText}" Foreground="#FF9D9D9D"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                               Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisible}}" />

                    <!-- A cor NÃO pode vir como atributo aqui. Um valor local vence setter de
                         gatilho de Style no WPF, então um `Foreground=...` no elemento deixaria
                         a palavra cinza para sempre — o `Text` mudava (não é local) e a cor
                         não. Era o caso antes, e passou despercebido porque o ponto ao lado do
                         nome já dava o sinal. Cor padrão e cor de conectado saem as duas do
                         Style, que é onde o gatilho alcança. -->
                    <TextBlock Grid.Column="3" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="pareado" />
                          <Setter Property="Foreground" Value="#FF9D9D9D" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Connected}" Value="True">
                              <Setter Property="Text" Value="conectado" />
                              <Setter Property="Foreground" Value="#FF6CCB5F" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>

                    <!-- tira este aparelho da lista da barra; ele continua pareado no Windows.
                         Só aparece com o mouse na linha, para a lista ficar limpa. -->
                    <Button x:Name="Hide" Grid.Column="4" Style="{StaticResource PanelButton}"
                            Padding="6,0" Margin="6,0,0,0" Opacity="0"
                            Click="OnHideBluetoothDevice" Tag="{Binding Name}"
                            ToolTip="Não mostrar este aparelho na barra">
                      <TextBlock Text="✕" Foreground="#FFE8E8EA" FontSize="11" />
                    </Button>
                    </Grid>
                  </Border>

                  <DataTemplate.Triggers>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                      <Setter TargetName="Hide" Property="Opacity" Value="1" />
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="#22FFFFFF" Margin="0,10,0,8" />

            <!-- so aparece quando ha algo escondido -->
            <Button Style="{StaticResource PanelButton}" HorizontalContentAlignment="Left"
                    Click="OnShowAllBluetooth"
                    Visibility="{Binding HasHiddenBluetooth, Converter={StaticResource BoolToVisible}}">
              <TextBlock Foreground="#FF9D9D9D" FontSize="12"
                         Text="{Binding HiddenBluetoothCount, StringFormat='Mostrar {0} aparelho(s) oculto(s)'}" />
            </Button>

            <Button Style="{StaticResource PanelButton}" HorizontalContentAlignment="Left"
                    Click="OnBluetoothSettings">
              <TextBlock Text="Configurações de Bluetooth" Foreground="#FF4CC2FF" FontSize="12" />
            </Button>
          </StackPanel>
        </Border>
      </Popup>

      <!-- o controle de volume, no mesmo desenho do painel do Windows -->
      <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel Width="280">

            <!-- mesmo cabeçalho do painel de bluetooth, para os dois combinarem -->
            <Grid Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal">
                <ui:GlyphIcon Glyph="{Binding VolumeGlyph}" Fill="#FFF2F2F2" Size="16"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Volume" Foreground="#FFF2F2F2" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Foreground="#FF9D9D9D" FontSize="12" />
            </Grid>

            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource PanelButton}" Click="OnMute" ToolTip="Sem som">
                <ui:GlyphIcon Glyph="{Binding VolumeGlyph}" Fill="#FFF2F2F2" Size="15" VerticalAlignment="Center" />
              </Button>
              <Slider Style="{StaticResource FluentSlider}" Width="205" Margin="8,0,0,0"
                      Foreground="{Binding VolumeBrush}"
                      Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" />
            </StackPanel>

            <!-- o mixer: um controle por programa com som, como no painel do Windows.
                 A lista some quando nada está tocando — é o que o Windows também faz. -->
            <StackPanel Visibility="{Binding HasAppSessions, Converter={StaticResource BoolToVisible}}">
              <Border Height="1" Background="#22FFFFFF" Margin="0,12,0,8" />
              <TextBlock Text="Aplicativos" Foreground="#FF9D9D9D" FontSize="11"
                         FontWeight="SemiBold" Margin="2,0,0,4" />

              <ItemsControl ItemsSource="{Binding AppSessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4,0,2">
                      <StackPanel Orientation="Horizontal" Margin="2,0,0,3">
                        <Image Source="{Binding Icon}" Width="14" Height="14" VerticalAlignment="Center"
                               Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisible}}" />
                        <TextBlock Text="{Binding Name}" Foreground="#FFE8E8EA" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="185" />
                        <TextBlock Text="{Binding Level, StringFormat='{}{0}%'}" Foreground="#FF9D9D9D"
                                   FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                      </StackPanel>

                      <StackPanel Orientation="Horizontal">
                        <!-- o alto-falante de cada linha corta o som só daquele programa -->
                        <Button Style="{StaticResource PanelButton}" Click="OnMuteApp" Tag="{Binding ProcessId}"
                                Padding="6,2" ToolTip="Sem som para este aplicativo">
                          <ui:GlyphIcon Glyph="{Binding Glyph}" Fill="#FFF2F2F2" Size="13"
                                        VerticalAlignment="Center" />
                        </Button>
                        <Slider Style="{StaticResource FluentSlider}" Width="216" Margin="6,0,0,0"
                                Minimum="0" Maximum="100" Value="{Binding Level, Mode=TwoWay}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- as saidas ligadas; clicar troca a padrao -->
            <Border Height="1" Background="#22FFFFFF" Margin="0,10,0,8" />
            <ItemsControl ItemsSource="{Binding AudioDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource PanelButton}" HorizontalContentAlignment="Left"
                          Click="OnAudioDevice" Tag="{Binding Id}" ToolTip="{Binding Name}">
                    <StackPanel Orientation="Horizontal">
                      <!-- a bolinha marca qual esta em uso -->
                      <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#00000000" />
                            <Setter Property="Stroke" Value="#66FFFFFF" />
                            <Setter Property="StrokeThickness" Value="1" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter Property="Fill" Value="#FF4CC2FF" />
                                <Setter Property="Stroke" Value="#FF4CC2FF" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Text="{Binding Name}" Foreground="#FFE8E8EA" FontSize="12"
                                 TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>

      <!-- Os dispositivos externos, um por linha, e o recado da última tentativa embaixo.
           Uma linha inteira é o botão: o alvo do clique é a linha toda, e não um "✕" de seis
           pixels no canto — remover é a única coisa que se faz aqui. -->
      <Popup x:Name="RemovablePopup" PlacementTarget="{Binding ElementName=RemovableButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <!-- O cartão inteiro é desligado enquanto uma remoção está em curso, em vez de
               cada linha por sua conta: dentro do DataTemplate o item é o RemovableDevice, e
               um binding para `RemovableReady` ali procuraria a propriedade dentro dele, onde
               ela não existe — o botão ficaria sempre ligado e aceitaria o segundo clique.
               Aqui o DataContext ainda é o modelo da barra. -->
          <StackPanel Width="280" IsEnabled="{Binding RemovableReady}">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <ui:GlyphIcon Glyph="{Binding RemovableGlyph}" Fill="#FFF2F2F2" Size="16"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Text="Remover com segurança" Foreground="#FFF2F2F2" FontSize="14"
                         FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Removable}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- A linha NÃO é um botão: são duas ações, e um botão dentro de outro
                       deixaria "abrir" e "remover" disputando o mesmo clique. O realce de
                       mouse, que o PanelRow daria de graça, sai do gatilho lá embaixo. -->
                  <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                          Padding="8,7" Margin="0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="#FFE8E8EA" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Foreground="#FF9D9D9D" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <!-- As palavras, e não ícones. Nenhum glifo da fonte diz "ejetar" sem
                           ambiguidade em 13 px — a seta para cima lê-se como "enviar" e o
                           chevron, como "abre outra coisa" —, e com duas ações na mesma linha
                           a diferença entre elas é o que mais precisa ficar claro. -->
                      <Button Grid.Column="1" Style="{StaticResource PanelButton}" Padding="6,2"
                              Click="OnOpenRemovable" Tag="{Binding Id}"
                              ToolTip="Abrir no Explorer">
                        <TextBlock Text="Abrir" Foreground="#FF4CC2FF" FontSize="11" />
                      </Button>

                      <Button Grid.Column="2" Style="{StaticResource PanelButton}" Padding="6,2"
                              Margin="2,0,0,0"
                              Click="OnEjectRemovable" Tag="{Binding Id}"
                              ToolTip="Remover este dispositivo com segurança">
                        <TextBlock Text="Remover" Foreground="#FF4CC2FF" FontSize="11" />
                      </Button>
                    </Grid>
                  </Border>

                  <DataTemplate.Triggers>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- só aparece depois de uma tentativa; é aqui que o veto do Windows vira frase -->
            <TextBlock Text="{Binding RemovableMessage}" Foreground="#FF9D9D9D" FontSize="11"
                       TextWrapping="Wrap" Margin="2,10,2,0"
                       Visibility="{Binding HasRemovableMessage, Converter={StaticResource BoolToVisible}}" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- O cartão das atualizações: o que o Windows Update já sabe, e o que o winget vê. Cada
           metade leva ao lugar onde ela se resolve — nada é instalado daqui. -->
      <!-- a hora com segundos, ao clicar no horário. Algarismos de largura fixa: em fonte
           proporcional o "1" é mais estreito, e o número inteiro tremeria a cada segundo -->
      <Popup x:Name="ClockPopup" Placement="Custom"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
             Closed="OnClockClosed">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="20,14,20,16" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel MinWidth="200">
            <TextBlock Text="{Binding ClockSeconds}" Foreground="#FFF2F2F2" FontSize="34"
                       FontWeight="Light" HorizontalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" />
            <TextBlock Text="{Binding ClockLongDate}" Foreground="#FF9D9D9D" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </Popup>

      <Popup x:Name="UpdatesPopup" PlacementTarget="{Binding ElementName=UpdatesButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel Width="300">
            <TextBlock Text="Atualizações" Foreground="#FFF2F2F2" FontSize="13"
                       FontWeight="SemiBold" Margin="2,0,0,10" />

            <!-- tudo em dia: a frase diz de que fontes se está falando, e a hora embaixo diz que a
                 dock olhou mesmo — sem isso, "nada para atualizar" e "ninguém conferiu" são a
                 mesma tela -->
            <TextBlock Text="{Binding UpdatesEmptyText}" Foreground="#FF9D9D9D" FontSize="12"
                       TextWrapping="Wrap" Margin="2,0,2,2">
              <TextBlock.Visibility>
                <Binding Path="HasUpdatesPending">
                  <Binding.Converter>
                    <ui:InverseBoolToVisibility />
                  </Binding.Converter>
                </Binding>
              </TextBlock.Visibility>
            </TextBlock>

            <!-- Windows Update: o botão leva à página dele, que é onde se instala. Os títulos vêm
                 abaixo, como o Windows os escreve — sem eles, "1 atualização do Windows" não diz se
                 é o cumulativo do mês ou a definição do Defender, que se instala sozinha -->
            <StackPanel Visibility="{Binding HasWindowsUpdates, Converter={StaticResource BoolToVisible}}">
              <Button Style="{StaticResource PanelRow}" Click="OnOpenWindowsUpdate"
                      ToolTip="Abrir o Windows Update">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding WindowsUpdatesText}" Foreground="#FFE8E8EA" FontSize="12"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Abrir" Foreground="#FF4CC2FF" FontSize="11"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>

              <ItemsControl ItemsSource="{Binding WindowsUpdates}" Margin="10,2,2,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#FF8A8A8A" FontSize="11" Margin="0,1"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ui:Ellipsis.ShowTooltip="True" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- winget: a lista dos pacotes, com a versão de onde para onde -->
            <StackPanel Margin="0,4,0,0"
                        Visibility="{Binding HasWingetUpdates, Converter={StaticResource BoolToVisible}}">
              <Border Height="1" Background="#22FFFFFF" Margin="2,4,2,8" />
              <TextBlock Foreground="#FF9D9D9D" FontSize="11" Margin="2,0,0,4" Text="Pelo winget" />

              <ItemsControl ItemsSource="{Binding WingetUpdates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- o realce segue o mouse, e é ele que revela os dois botões da linha -->
                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="2,3" Margin="0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="#FFE8E8EA" FontSize="12"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ui:Ellipsis.ShowTooltip="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Foreground="#FF8A8A8A" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center" ToolTip="{Binding Hint}">
                          <Run Text="{Binding Current, Mode=OneWay}" />
                          <Run Text="→" Foreground="#FF6A6A6A" />
                          <Run Text="{Binding Available, Mode=OneWay}" Foreground="#FF4CC2FF" />
                        </TextBlock>

                        <!-- só para os que o "Atualizar tudo" não alcança: esses precisam de um
                             comando com o id deles, e sem este botão ficariam na lista sem saída -->
                        <Button Grid.Column="2" Style="{StaticResource PanelButton}"
                                Padding="6,0" Margin="8,0,0,0"
                                Click="OnWingetUpgradeOne" Tag="{Binding Id}"
                                ToolTip="Atualizar só este, sem abrir janela"
                                IsEnabled="{Binding DataContext.UpdatesIdle,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Visibility="{Binding Explicit, Converter={StaticResource BoolToVisible}}">
                          <TextBlock Text="Atualizar" Foreground="#FF4CC2FF" FontSize="11" />
                        </Button>

                        <!-- o pacote que o winget oferece e nunca atualiza para de contar aqui -->
                        <Button x:Name="Silence" Grid.Column="3" Style="{StaticResource PanelButton}"
                                Padding="6,0" Margin="6,0,0,0" Opacity="0"
                                Click="OnSilenceWinget" Tag="{Binding Key}"
                                ToolTip="Parar de avisar sobre este pacote">
                          <TextBlock Text="✕" Foreground="#FFE8E8EA" FontSize="11" />
                        </Button>
                      </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                        <Setter TargetName="Silence" Property="Opacity" Value="1" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- some quando só restam os que exigem alvo explícito: esses ele não atualiza -->
              <Button Style="{StaticResource PanelButton}" Click="OnWingetUpgradeAll" Margin="0,8,0,0"
                      HorizontalContentAlignment="Center" IsEnabled="{Binding UpdatesIdle}"
                      ToolTip="Atualiza sem abrir janela; o cartão avisa quando termina"
                      Visibility="{Binding HasWingetUpgradeAll, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="Atualizar tudo pelo winget" Foreground="#FF4CC2FF" FontSize="12" />
              </Button>
            </StackPanel>

            <!-- o que está calado: fora da conta do ícone, mas à vista, e com o desfazer ao lado.
                 Aparece mesmo com o resto vazio — silêncio que não se vê vira esquecimento -->
            <Button Style="{StaticResource PanelButton}" HorizontalContentAlignment="Left"
                    Margin="0,8,0,0" Click="OnUnsilenceWinget"
                    ToolTip="Voltar a contar estes pacotes nas atualizações"
                    Visibility="{Binding HasWingetSilenced, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{Binding WingetSilencedText}" Foreground="#FF9D9D9D" FontSize="11" />
            </Button>

            <!-- "Conferir agora" faz sentido agora que o ícone fica sempre na barra: com ele
                 apagado, a pergunta "será que isso está atualizado?" tem de ter resposta sem
                 esperar as próximas três horas -->
            <!-- "não consegui perguntar" não pode parecer "não há nada": é metade do defeito de
                 28/09, e a outra metade era perguntar só ao cache do Windows -->
            <TextBlock Text="{Binding UpdatesError}" Foreground="#FFE8A33D" FontSize="11"
                       TextWrapping="Wrap" Margin="2,8,2,0"
                       Visibility="{Binding HasUpdatesError, Converter={StaticResource BoolToVisible}}" />

            <!-- sem terminal, esta é a única notícia de que a atualização falhou — e por isso vem
                 com a porta do terminal ao lado, que é onde um instalador teimoso se resolve -->
            <StackPanel Margin="2,8,2,0"
                        Visibility="{Binding HasUpgradeError, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{Binding UpgradeError}" Foreground="#FFE8A33D" FontSize="11"
                         TextWrapping="Wrap" />
              <Button Style="{StaticResource PanelButton}" Click="OnWingetTerminal" Margin="0,4,0,0"
                      HorizontalContentAlignment="Left"
                      ToolTip="Abre um terminal com o winget upgrade --all, para ver o processo inteiro">
                <TextBlock Text="Tentar num terminal" Foreground="#FF4CC2FF" FontSize="11" />
              </Button>
            </StackPanel>

            <Grid Margin="0,10,0,0">
              <TextBlock Text="{Binding UpdatesReadAt}" Foreground="#FF6A6A6A" FontSize="10"
                         VerticalAlignment="Center" Margin="2,0,0,0" />
              <Button Style="{StaticResource PanelButton}" Click="OnRefreshUpdates"
                      HorizontalAlignment="Right" Padding="8,2" ToolTip="Perguntar de novo, agora">
                <TextBlock Text="Conferir agora" Foreground="#FF4CC2FF" FontSize="11" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </Popup>

      <!-- O cartão da cota de IA. O conteúdo mora no AiUsageCard, que pode ser montado
           sozinho num harness para conferir o desenho. -->
      <Popup x:Name="AiUsagePopup" PlacementTarget="{Binding ElementName=AiUsageButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <views:AiUsageCard />
      </Popup>

      <!-- O card da mídia: capa, o que está tocando, onde a faixa está e os controles
           maiores. A barra de progresso aceita clique para pular no tempo. -->
      <Popup x:Name="MediaPopup" PlacementTarget="{Binding ElementName=MediaButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel Width="280">

            <!-- Encostado à esquerda, como o dos outros cards: mesmo sem um controle à direita
                 para dividir a linha, alinhar com o conteúdo abaixo pesa mais que centralizar
                 (tentado, e o card ficou com dois eixos brigando). -->
            <Grid Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <ui:GlyphIcon Glyph="&#xE8D6;" Fill="#FFF2F2F2" Size="16"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Tocando agora" Foreground="#FFF2F2F2" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal">
              <!-- a capa, quando o programa publica uma; o quadro fica lá de qualquer jeito
                   para o card não mudar de largura entre uma faixa e outra -->
              <Border Width="56" Height="56" CornerRadius="6" Background="#22FFFFFF"
                      VerticalAlignment="Top">
                <Image Source="{Binding Media.Cover}" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>

              <StackPanel Margin="12,0,0,0" Width="200" VerticalAlignment="Center">
                <TextBlock Text="{Binding Media.Title}" Foreground="#FFE8E8EA" FontSize="12"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Media.Artist}" Foreground="#FFE8E8EA" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                <TextBlock Text="{Binding Media.Album}" Foreground="#FF9D9D9D" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>

            <!-- progresso: o trilho inteiro é clicável, e a conta de onde se clicou vira o
                 ponto da faixa (veja OnMediaSeek) -->
            <Border x:Name="MediaTrack" Height="4" CornerRadius="2" Background="#33FFFFFF"
                    Margin="0,14,0,0" Cursor="Hand" MouseLeftButtonUp="OnMediaSeek">
              <Rectangle x:Name="MediaFill" Fill="#FF4CC2FF" RadiusX="2" RadiusY="2"
                         HorizontalAlignment="Left" />
            </Border>

            <Grid Margin="0,6,0,0">
              <TextBlock Text="{Binding MediaElapsed}" Foreground="#FF9D9D9D" FontSize="11"
                         HorizontalAlignment="Left" />
              <TextBlock Text="{Binding MediaRemaining}" Foreground="#FF9D9D9D" FontSize="11"
                         HorizontalAlignment="Right" />
            </Grid>

            <!-- Sem controles aqui: eles vivem na barra, a um clique de distância, e repetidos
                 no card só engordavam a caixa. O que o card ainda faz além de informar é a
                 linha do tempo acima, que aceita clique para pular na faixa. -->
          </StackPanel>
        </Border>
      </Popup>

      <!-- O cartão de ferramentas: uma linha por comando, e o clique roda e fecha.

           Apertado de propósito — 12 px e linhas de 26 px, a metade do respiro dos outros
           cartões: é uma lista de atalhos, lida de relance, e cresce com o gosto de quem a
           monta. Nos ícones compactos ele ainda encolhe a 90%, como o calendário. -->
      <Popup x:Name="ToolsPopup" PlacementTarget="{Binding ElementName=ToolsButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="8,10,8,8" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding PanelCompact}" Value="True">
                  <Setter Property="LayoutTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel MinWidth="220" MaxWidth="320">

            <Grid Margin="6,0,2,6">
              <StackPanel Orientation="Horizontal">
                <ui:GlyphIcon Glyph="&#xE90F;" Fill="#FFF2F2F2" Size="13"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Ferramentas" Foreground="#FFF2F2F2" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Button Style="{StaticResource PanelButton}" HorizontalAlignment="Right" Padding="5,2"
                      Click="OnToolsEdit" ToolTip="Editar a lista nas Configurações">
                <ui:GlyphIcon Glyph="&#xE70F;" Fill="#FF9D9D9D" Size="11" VerticalAlignment="Center" />
              </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding Tools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource PanelRowCompact}" Click="OnToolRun" Tag="{Binding}"
                          ToolTip="{Binding Command}">
                    <Grid Height="20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ui:GlyphIcon Glyph="{Binding Glyph}" Fill="{Binding Fill}" Size="13"
                                    Width="16" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#FFE8E8EA"
                                 FontSize="12" VerticalAlignment="Center" Margin="9,0,4,0"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Nenhum comando na lista. Use o lápis para montar a sua."
                       Foreground="#FF9D9D9D" FontSize="11" Margin="6,2,6,4" TextWrapping="Wrap"
                       Visibility="{Binding HasNoTools, Converter={StaticResource BoolToVisible}}" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- O cartão de sistema: o último minuto de cada medida, no mesmo desenho dos outros
           cartões da barra.

           Um cartão para os dois itens, e não um para cada: rede, processador e memória são
           a mesma pergunta — "o que esta máquina está fazendo agora" —, e quem abre por causa
           de um pico de rede quer ver na mesma hora se a CPU acompanhou. Os dois botões da
           barra abrem este mesmo cartão. -->
      <Popup x:Name="SystemPopup" PlacementTarget="{Binding ElementName=SystemButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel Width="280">

            <Grid Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <ui:GlyphIcon Glyph="&#xE9D2;" Fill="#FFF2F2F2" Size="16"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Sistema" Foreground="#FFF2F2F2" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="último minuto" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Foreground="#FF9D9D9D" FontSize="11" />
            </Grid>

            <!-- Quatro linhas iguais: nome à esquerda, valor à direita, gráfico embaixo.
                 CPU e memória têm o teto fixo em 100 — sem isso, uma máquina parada
                 desenharia o ruído de 2% como se fosse uma montanha. A rede não tem teto
                 conhecido, então a escala dela é o maior valor do próprio minuto. -->
            <Grid Margin="0,0,0,10">
              <TextBlock Text="Processador" Foreground="#FFD8D8DA" FontSize="12" />
              <TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right"
                         Foreground="#FF9D9D9D" FontSize="12" />
            </Grid>
            <ui:Sparkline Values="{Binding CpuHistory}" Maximum="100" Height="34"
                          Stroke="#FFF4A261" Margin="0,0,0,14" />

            <Grid Margin="0,0,0,10">
              <TextBlock Text="Memória" Foreground="#FFD8D8DA" FontSize="12" />
              <TextBlock Text="{Binding RamText}" HorizontalAlignment="Right"
                         Foreground="#FF9D9D9D" FontSize="12" />
            </Grid>
            <ui:Sparkline Values="{Binding RamHistory}" Maximum="100" Height="34"
                          Stroke="#FFB08AE8" Margin="0,0,0,14" />

            <Grid Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal">
                <ui:GlyphIcon Glyph="&#xE896;" Fill="#FF7FD18B" Size="11" VerticalAlignment="Center"
                              Margin="0,0,6,0" />
                <TextBlock Text="Recebendo" Foreground="#FFD8D8DA" FontSize="12" />
              </StackPanel>
              <TextBlock Text="{Binding NetDown}" HorizontalAlignment="Right"
                         Foreground="#FF9D9D9D" FontSize="12" />
            </Grid>
            <ui:Sparkline Values="{Binding DownHistory}" Height="34"
                          Stroke="#FF7FD18B" Margin="0,0,0,14" />

            <Grid Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal">
                <ui:GlyphIcon Glyph="&#xE898;" Fill="#FF7FB2F0" Size="11" VerticalAlignment="Center"
                              Margin="0,0,6,0" />
                <TextBlock Text="Enviando" Foreground="#FFD8D8DA" FontSize="12" />
              </StackPanel>
              <TextBlock Text="{Binding NetUp}" HorizontalAlignment="Right"
                         Foreground="#FF9D9D9D" FontSize="12" />
            </Grid>
            <ui:Sparkline Values="{Binding UpHistory}" Height="34" Stroke="#FF7FB2F0" />

          </StackPanel>
        </Border>
      </Popup>

      <!-- O card do brilho: o mesmo desenho do de volume, sem a lista de aplicativos —
           brilho é um só. -->
      <Popup x:Name="BrightnessPopup" PlacementTarget="{Binding ElementName=BrightnessButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel Width="280">
            <Grid Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal">
                <ui:GlyphIcon Glyph="{Binding BrightnessGlyph}" Fill="#FFF2F2F2" Size="16"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Brilho" Foreground="#FFF2F2F2" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Brightness, StringFormat='{}{0}%'}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Foreground="#FF9D9D9D" FontSize="12" />
            </Grid>

            <Slider Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100"
                    Value="{Binding Brightness, Mode=TwoWay}" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- Mostrador do volume ao rolar a roda sobre o alto-falante, no espírito do OSD do
           Windows: aparece no primeiro giro, acompanha os seguintes e some sozinho.

           IsHitTestVisible="False" é o que o mantém inofensivo — ele nasce debaixo do
           cursor, e sem isso roubaria a roda do próprio botão já no segundo giro. Pela
           mesma razão fica fora de AnyPopupOpen: não é um painel que o clique fora fecha. -->
      <Popup x:Name="VolumeOsd" PlacementTarget="{Binding ElementName=VolumeButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" IsHitTestVisible="False">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="10" IsHitTestVisible="False">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel Width="150">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ui:GlyphIcon Glyph="{Binding VolumeGlyph}" Fill="#FFF2F2F2" Size="16"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}" Foreground="#FFF2F2F2"
                         FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- o trilho, e por cima dele a parte preenchida — o mesmo desenho da pilha da
                 bateria, com a largura vindo pronta do modelo (veja VolumeFill) -->
            <Border Height="4" CornerRadius="2" Background="#33FFFFFF">
              <Rectangle Width="{Binding VolumeFill}" Fill="{Binding VolumeBrush}"
                         RadiusX="2" RadiusY="2" HorizontalAlignment="Left" />
            </Border>
          </StackPanel>
        </Border>
      </Popup>

      <!-- o cartão da bandeja, no desenho do painel de ícones ocultos do Windows: uma
           grade de ícones, cinco por linha. Some sozinho depois de três segundos parado. -->
      <!-- sem PopupAnimation: o cartão abre em uns 100 ms e a esmaecida do WPF, que dura
           mais que isso, aparecia como "ficou translúcido e depois apareceu" -->
      <Popup x:Name="TrayPopup" PlacementTarget="{Binding ElementName=TrayButton}"
             Placement="Custom"
             StaysOpen="True" AllowsTransparency="True"
             MouseMove="OnTrayCardActivity">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="8" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <Grid>
            <!-- enquanto a leitura não volta, o cartão mostra que está trabalhando em vez
                 de aparecer vazio e depois pular para a lista cheia -->
            <TextBlock Text="Lendo a bandeja…" Foreground="#FF9D9D9D" FontSize="12"
                       Margin="10,14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasTrayIcons, Converter={StaticResource BoolToCollapsed}}" />

            <ItemsControl ItemsSource="{Binding TrayIcons}"
                          Visibility="{Binding HasTrayIcons, Converter={StaticResource BoolToVisible}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- pelo ItemsControl, e não por herança: o contexto de dados não chega
                       de forma confiável dentro de um ItemsPanelTemplate -->
                  <UniformGrid Columns="{Binding DataContext.TrayColumns,
                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- o botão direito abre o menu do programa (o "Sair" e companhia), como
                       na bandeja do Windows -->
                  <Button Style="{StaticResource TrayCardButton}" Click="OnTrayIcon"
                          MouseRightButtonUp="OnTrayIconMenu"
                          Tag="{Binding Position}" ToolTip="{Binding Label}">
                    <Image Source="{Binding Image}" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Popup>

      <!-- energia -->
      <Popup x:Name="PowerPopup" PlacementTarget="{Binding ElementName=PowerButton}"
             Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="10,10" Margin="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel Width="235">

            <!-- Quem está usando a máquina, no espírito do menu do GNOME (EV22): a foto da
                 conta e o nome antes das opções. Sem foto configurada, as iniciais num
                 círculo — dizem mais que o boneco cinza padrão do Windows. -->
            <StackPanel Orientation="Horizontal" Margin="8,4,0,10">
              <Grid Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse Fill="#33FFFFFF"
                         Visibility="{Binding NoUserPicture, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="{Binding UserInitials}" Foreground="#FFF2F2F2" FontSize="14"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NoUserPicture, Converter={StaticResource BoolToVisible}}" />

                <!-- a foto vem quadrada; o recorte circular é o que a deixa igual à do
                     Windows, e o Ellipse com ImageBrush é o jeito de fazer isso no WPF -->
                <Ellipse Visibility="{Binding HasUserPicture, Converter={StaticResource BoolToVisible}}">
                  <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding UserPicture}" Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                  </Ellipse.Fill>
                </Ellipse>
              </Grid>

              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding UserName}" Foreground="#FFF2F2F2" FontSize="14"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                <TextBlock Text="Conectado" Foreground="#FF9D9D9D" FontSize="11" Margin="0,1,0,0" />
              </StackPanel>
            </StackPanel>

            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,6" />

            <!-- a ordem vem do serviço: o que interrompe o trabalho fica embaixo, longe
                 da borda de cima, onde o cursor chega primeiro -->
            <ItemsControl ItemsSource="{Binding PowerCommands}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <!-- a linha entre o que mexe na sessão e o que mexe na máquina; quem
                         decide onde ela cai é o serviço, pelo StartsGroup -->
                    <Border Height="1" Background="#22FFFFFF" Margin="8,5,8,6"
                            Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisible}}" />

                    <Button Style="{StaticResource PanelRow}" Click="OnPowerCommand" Tag="{Binding Name}"
                            ToolTip="{Binding Description}">
                      <StackPanel Orientation="Horizontal">
                        <ui:GlyphIcon Glyph="{Binding Glyph}" Fill="#FFF2F2F2" Size="15"
                                      VerticalAlignment="Center" Margin="2,0,12,0" />
                        <TextBlock Text="{Binding Name}" Foreground="#FFE8E8EA" FontSize="13"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>

      <!-- o calendário do mês, desenhado aqui: o Calendar do WPF viria com o tema claro -->
      <Popup x:Name="CalendarPopup" Placement="Custom"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <!-- a roda do mouse folheia os meses, como no calendário do Windows: as setas do
             cabeçalho são pequenas e passam despercebidas, e rolar é o gesto que a pessoa
             tenta primeiro -->
        <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="14,12" Margin="10" DataContext="{Binding Calendar}"
                PreviewMouseWheel="OnCalendarWheel">
          <!-- nos ícones compactos o cartão inteiro encolhe a 90%: são dezenas de medidas (título,
               dias, células, a lista de tarefas e os campos), e a escala as leva juntas, na mesma
               proporção — os números dos dias ficam nos ~11 px dos outros itens compactos. O
               contexto aqui é o calendário, então a opção é lida do Popup, que tem o da barra -->
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.PanelCompact, ElementName=CalendarPopup}" Value="True">
                  <Setter Property="LayoutTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
          </Border.Effect>
          <StackPanel Width="252">

            <!-- mês e as setas -->
            <Grid Margin="0,0,0,8">
              <TextBlock Text="{Binding Title}" Foreground="#FFF2F2F2" FontSize="13"
                         FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
              <!-- em 11 px estas setas passavam despercebidas e a navegação parecia não
                   existir; 13 px é o tamanho dos outros ícones dos cards -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PanelButton}" Click="OnCalendarPrevious"
                        Padding="8,3" ToolTip="Mês anterior (ou role a roda do mouse)">
                  <ui:GlyphIcon Glyph="&#xE70E;" Fill="#FFF2F2F2" Size="13" VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource PanelButton}" Click="OnCalendarNext"
                        Padding="8,3" ToolTip="Próximo mês (ou role a roda do mouse)">
                  <ui:GlyphIcon Glyph="&#xE70D;" Fill="#FFF2F2F2" Size="13" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </Grid>

            <!-- iniciais dos dias da semana -->
            <ItemsControl ItemsSource="{Binding WeekHeaders}" Margin="0,0,0,2">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#FF8A8A8A" FontSize="11" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Margin="0,0,0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- as seis semanas; hoje ganha o círculo azul, como no Windows -->
            <ItemsControl ItemsSource="{Binding Days}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- o dia inteiro é clicável: é assim que se escreve a anotação dele -->
                  <Border x:Name="Cell" Width="32" Height="30" CornerRadius="15" Background="Transparent"
                          Cursor="Hand" MouseLeftButtonUp="OnCalendarDay"
                          ToolTip="{Binding Tooltip}" ToolTipService.IsEnabled="{Binding HasTooltip}">
                    <Grid>
                      <TextBlock x:Name="Number" Text="{Binding Text}" FontSize="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFE8E8EA" />
                            <Style.Triggers>
                              <!-- dias do mês vizinho entram apagados: eles existem só para a
                                   primeira e a última semana não ficarem tortas -->
                              <DataTrigger Binding="{Binding InMonth}" Value="False">
                                <Setter Property="Foreground" Value="#FF6A6A6A" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>

                      <!-- o pontinho embaixo do número marca quem tem anotação: a cor do texto
                           já está ocupada pelo feriado, e um dia pode ser as duas coisas -->
                      <Ellipse x:Name="NoteDot" Width="4" Height="4" Fill="#FF4CC2FF"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="0,0,0,3" Visibility="Collapsed" />
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <!-- feriado em vermelho; anotação em azul. A ordem importa: hoje vem por
                         último e ganha de todos, porque o círculo azul cheio já diz tudo -->
                    <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                      <Setter TargetName="Number" Property="Foreground" Value="#FFFF6B6B" />
                      <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasNote}" Value="True">
                      <Setter TargetName="NoteDot" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!-- tudo do dia resolvido: o ponto fica verde. É o "já cuidei disso" sem
                         precisar abrir a caixa para conferir -->
                    <DataTrigger Binding="{Binding AllDone}" Value="True">
                      <Setter TargetName="NoteDot" Property="Fill" Value="#FF6CCB5F" />
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasNote}" Value="True" />
                        <Condition Binding="{Binding IsHoliday}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter TargetName="Number" Property="Foreground" Value="#FF4CC2FF" />
                      <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                      <Setter TargetName="Cell" Property="Background" Value="#FF0F6CBD" />
                      <Setter TargetName="Number" Property="Foreground" Value="White" />
                      <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                      <Setter TargetName="NoteDot" Property="Fill" Value="White" />
                    </DataTrigger>
                    <!-- o dia escolhido ganha um anel: é dele a lista que aparece embaixo do mês -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="Cell" Property="BorderBrush" Value="#FF4CC2FF" />
                      <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Clique num dia para ver as tarefas" Foreground="#FF8A8A8A" FontSize="10"
                       HorizontalAlignment="Center" Margin="0,6,0,0">
              <TextBlock.Visibility>
                <Binding Path="HasSelection">
                  <Binding.Converter>
                    <ui:InverseBoolToVisibility />
                  </Binding.Converter>
                </Binding>
              </TextBlock.Visibility>
            </TextBlock>

            <!-- as tarefas do dia escolhido, tudo no próprio cartão: marcar feito, remover, mover e
                 escrever. A barra é WS_EX_NOACTIVATE e não recebe teclado; os dois campos de texto
                 pedem o teclado para ela só quando são clicados (OnCalendarFieldMouseDown) -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
              <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,8" />
              <TextBlock Text="{Binding SelectedTitle}" Foreground="#FFF2F2F2" FontSize="12"
                         FontWeight="SemiBold" Margin="4,0,0,2" />
              <TextBlock Text="{Binding SelectedHoliday}" Foreground="#FFFF6B6B" FontSize="11" Margin="4,0,0,2"
                         Visibility="{Binding HasSelectedHoliday, Converter={StaticResource BoolToVisible}}" />
              <TextBlock Text="Nada anotado neste dia." Foreground="#FF8A8A8A" FontSize="11" Margin="4,2,0,2"
                         Visibility="{Binding SelectedEmpty, Converter={StaticResource BoolToVisible}}" />

              <ItemsControl ItemsSource="{Binding SelectedNotes}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                  <!--
                    Cada tarefa num balão: fundo próprio, canto redondo e uma folga em volta. Em
                    linhas soltas, o texto de uma tarefa e as ações da seguinte ficavam a dois
                    pixels um do outro, e o dia com cinco tarefas virava um bloco de texto.

                    O texto vem numa linha só, cortado com reticências, e a dica de mouse mostra o
                    resto — mas só quando há resto (ui:Ellipsis.ShowTooltip). Antes ele quebrava em
                    quantas linhas precisasse, e uma tarefa comprida sozinha empurrava o resto da
                    lista para fora do cartão. Clicar no texto abre o campo para corrigi-lo.
                  -->
                  <DataTemplate>
                    <Border x:Name="Balao" Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="6,5" Margin="0,2">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource PanelButton}" Click="OnCalendarNoteDone" Padding="4,3"
                                VerticalAlignment="Center" ToolTip="Marcar como feito (de novo, desmarca)">
                          <Border x:Name="Bolinha" Width="14" Height="14" CornerRadius="7" BorderThickness="1.5"
                                  BorderBrush="#FF8A8A8A" Background="Transparent">
                            <TextBlock x:Name="Visto" Text="✓" FontSize="9" Foreground="White" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </Button>

                        <!-- o texto e, no lugar dele, o campo de correção -->
                        <Grid Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                          <TextBlock x:Name="Texto" Text="{Binding Text}" Foreground="#FFE8E8EA" FontSize="12"
                                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Cursor="IBeam"
                                     ui:Ellipsis.ShowTooltip="True" VerticalAlignment="Center"
                                     MouseLeftButtonUp="OnCalendarNoteEdit" />
                          <TextBox x:Name="Editor" Style="{StaticResource CalendarField}" MaxLength="200"
                                   Visibility="Collapsed" Text="{Binding Text, Mode=OneTime}" Padding="4,2"
                                   KeyDown="OnNoteEditKeyDown" LostKeyboardFocus="OnNoteEditFinish"
                                   IsVisibleChanged="OnNoteEditorShown"
                                   PreviewMouseLeftButtonDown="OnCalendarFieldMouseDown" />
                        </Grid>

                        <!-- a hora à esquerda, as ações à direita: numa linha só elas disputariam a
                             largura com o texto, que é o que interessa ler -->
                        <Grid Grid.Row="1" Grid.Column="1" Margin="4,3,0,0">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Hora" Text="{Binding TimeText}" Foreground="#FF4CC2FF" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding HasTime, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock x:Name="Sino" Text="🔔" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"
                                       ToolTip="Esta tarefa avisa quando chegar a hora"
                                       Visibility="{Binding Notify, Converter={StaticResource BoolToVisible}}" />
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PanelButton}" Click="OnCalendarNoteTime"
                                    Padding="5,2" ToolTip="Marcar a hora">
                              <TextBlock Text="🕘" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource PanelButton}" Click="OnCalendarNoteNotify"
                                    Padding="5,2" ToolTip="Avisar quando chegar a hora">
                              <TextBlock x:Name="SinoBotao" Text="🔔" FontSize="11" Opacity="0.45" />
                            </Button>
                            <Button Style="{StaticResource PanelButton}" Click="OnCalendarNoteMove"
                                    Padding="5,2" ToolTip="Mover para outro dia">
                              <TextBlock Text="→" Foreground="#FF8A8A8A" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource PanelButton}" Click="OnCalendarNoteRemove"
                                    Padding="5,2" ToolTip="Remover">
                              <TextBlock Text="✕" Foreground="#FF8A8A8A" FontSize="11" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Done}" Value="True">
                        <Setter TargetName="Bolinha" Property="Background" Value="#FF6CCB5F" />
                        <Setter TargetName="Bolinha" Property="BorderBrush" Value="#FF6CCB5F" />
                        <Setter TargetName="Visto" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Texto" Property="TextDecorations" Value="Strikethrough" />
                        <Setter TargetName="Texto" Property="Foreground" Value="#FF8A8A8A" />
                        <Setter TargetName="Hora" Property="Foreground" Value="#FF8A8A8A" />
                        <Setter TargetName="Balao" Property="Opacity" Value="0.75" />
                      </DataTrigger>
                      <!-- o sino aceso mostra que a tarefa avisa; apagado, que ela só está escrita -->
                      <DataTrigger Binding="{Binding Notify}" Value="True">
                        <Setter TargetName="SinoBotao" Property="Opacity" Value="1" />
                      </DataTrigger>
                      <!-- em edição o texto sai e o campo entra, no mesmo lugar -->
                      <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter TargetName="Texto" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Editor" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- mover: só aparece depois do "→" de uma tarefa; um campo de data parado ali o tempo
                   todo pediria atenção para algo que quase nunca se usa -->
              <Border x:Name="MovePanel" Visibility="Collapsed" Margin="0,6,0,0" Background="#FF2D2D2D"
                      BorderBrush="#FF4CC2FF" BorderThickness="1" CornerRadius="6" Padding="8,6">
                <StackPanel>
                  <TextBlock x:Name="MoveHeading" Foreground="#FFC5C5C5" FontSize="11" TextWrapping="Wrap" />
                  <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MoveBox" Style="{StaticResource CalendarField}" MaxLength="10"
                             KeyDown="OnMoveKeyDown" PreviewMouseLeftButtonDown="OnCalendarFieldMouseDown" />
                    <Button Grid.Column="1" Style="{StaticResource PanelButton}" Click="OnMoveConfirm"
                            Padding="8,3" Margin="4,0,0,0">
                      <TextBlock Text="Mover" Foreground="#FF4CC2FF" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PanelButton}" Click="OnMoveCancel" Padding="8,3">
                      <TextBlock Text="Cancelar" Foreground="#FFC5C5C5" FontSize="12" />
                    </Button>
                  </Grid>
                  <TextBlock x:Name="MoveHint" Foreground="#FF8A8A8A" FontSize="10" Margin="0,4,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- a hora: mesmo formato do painel de mover, e pelo mesmo motivo — um campo de hora
                   parado embaixo de cada tarefa pediria atenção o tempo todo -->
              <Border x:Name="TimePanel" Visibility="Collapsed" Margin="0,6,0,0" Background="#FF2D2D2D"
                      BorderBrush="#FF4CC2FF" BorderThickness="1" CornerRadius="6" Padding="8,6">
                <StackPanel>
                  <TextBlock x:Name="TimeHeading" Foreground="#FFC5C5C5" FontSize="11" TextWrapping="Wrap" />
                  <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TimeBox" Style="{StaticResource CalendarField}" MaxLength="5"
                             KeyDown="OnTimeKeyDown" PreviewMouseLeftButtonDown="OnCalendarFieldMouseDown" />
                    <Button Grid.Column="1" Style="{StaticResource PanelButton}" Click="OnTimeConfirm"
                            Padding="8,3" Margin="4,0,0,0">
                      <TextBlock Text="Marcar" Foreground="#FF4CC2FF" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PanelButton}" Click="OnTimeClear" Padding="8,3"
                            ToolTip="Deixar a tarefa sem hora">
                      <TextBlock Text="Tirar" Foreground="#FFC5C5C5" FontSize="12" />
                    </Button>
                  </Grid>
                  <TextBlock x:Name="TimeHint" Foreground="#FF8A8A8A" FontSize="10" Margin="0,4,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- nova tarefa: o clique no campo é o que dá o teclado à barra -->
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewNoteBox" Style="{StaticResource CalendarField}" MaxLength="200"
                         KeyDown="OnNewNoteKeyDown" PreviewMouseLeftButtonDown="OnCalendarFieldMouseDown" />
                <TextBlock Text="Nova tarefa (ou “14:30 dentista”)..." Foreground="#FF6A6A6A" FontSize="12" Margin="9,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=NewNoteBox}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Style="{StaticResource PanelButton}" Click="OnNewNoteAdd"
                        Padding="10,3" Margin="4,0,0,0" ToolTip="Adicionar (ou tecle Enter)">
                  <TextBlock Text="+" Foreground="#FF4CC2FF" FontSize="15" />
                </Button>
              </Grid>
              <TextBlock Text="&quot;14:30 dentista&quot; marca a hora · clique no texto para corrigir · 🕘 hora · 🔔 avisa"
                         Foreground="#FF6A6A6A" FontSize="10" Margin="4,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- só aparece depois de folhear para outro mês -->
            <Button Style="{StaticResource PanelButton}" Click="OnCalendarToday" Margin="0,6,0,0"
                    HorizontalContentAlignment="Center">
              <Button.Visibility>
                <Binding Path="IsCurrentMonth">
                  <Binding.Converter>
                    <ui:InverseBoolToVisibility />
                  </Binding.Converter>
                </Binding>
              </Button.Visibility>
              <TextBlock Text="Voltar para hoje" Foreground="#FF4CC2FF" FontSize="12" />
            </Button>
          </StackPanel>
        </Border>
      </Popup>

    </Grid>
  </Border>
</Window>
