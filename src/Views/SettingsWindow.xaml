<Window x:Class="WinDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:WinDock.Interop"
        xmlns:ui="clr-namespace:WinDock.Ui"
        xmlns:services="clr-namespace:WinDock.Services"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Configurações do WinDock" Icon="/assets/windock.ico"
        Width="840" Height="720" ResizeMode="CanResize" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{StaticResource FluentWindow}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <!--
    O painel segue o desenho do app Configuracoes do Windows 11: cada opcao em seu
    cartao, titulo e explicacao a esquerda, controle a direita. Os controles em si
    (interruptor, slider, lista) estao em src/Ui/Fluent.xaml.
  -->

  <Window.Resources>
    <ui:HexBrushConverter x:Key="HexBrush" />
    <ui:IntToBoolConverter x:Key="IntToBool" />

    <!-- cada janela precisa dos seus: um recurso declarado no PanelWindow não alcança aqui,
         e usá-lo sem declarar não quebra a compilação — estoura só na hora de abrir -->
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <ui:EmptyToCollapsed x:Key="EmptyToCollapsed" />

    <!-- um item da navegação: o glifo, o nome e, no escolhido, o traço de destaque à esquerda e
         o fundo um tom acima — o desenho da coluna das Configurações do Windows 11 -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="GroupName" Value="nav" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource FluentText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Height="36" Margin="0,0,0,3">
              <Grid>
                <Border x:Name="Marca" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                        Background="{StaticResource FluentAccent}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="14,0,8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding (ui:NavGlyph.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                             VerticalAlignment="Center" Margin="0,0,12,0" />
                  <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13" />
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource FluentCard}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource FluentCardHover}" />
                <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── cabecalho ─────────────────────────────────────── -->
    <StackPanel Orientation="Horizontal" Margin="24,20,24,4">
      <Image Source="/assets/windock.png" Width="44" Height="44" VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality" />

      <TextBlock Text="WinDock" Foreground="{StaticResource FluentText}" Margin="14,0,10,0"
                 FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />

      <!-- as explicações que ficavam soltas na tela agora moram aqui dentro -->
      <Border Style="{StaticResource FluentHelp}"
              ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
        <Border.ToolTip>
          <ToolTip>
            <StackPanel>
              <TextBlock Text="Cada controle vale na hora, enquanto você arrasta o slider; o arquivo é salvo ao fechar esta janela."
                         TextWrapping="Wrap" />
              <TextBlock Text="Para mudar a ordem, arraste os ícones dentro da dock — a ordem é salva sozinha."
                         TextWrapping="Wrap" Margin="0,8,0,0" />
              <TextBlock Text="Alt+Espaço abre a busca de aplicativos."
                         TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </ToolTip>
        </Border.ToolTip>
        <TextBlock Text="?" Foreground="{StaticResource FluentTextDim}" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </StackPanel>

    <!-- Uma página por assunto, escolhida na coluna da esquerda, como nas Configurações do
         Windows. Era uma lista corrida só, e a seção "Barra superior" tinha crescido até umas
         trinta opções seguidas — em 01/10/2026 o usuário não achou a "Barra em ilhas" lá dentro.
         As páginas são os StackPanel Page* abaixo; quem mostra uma e esconde as outras é o
         ShowPage, no código. -->
    <Grid Grid.Row="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel x:Name="Nav" Margin="16,2,8,0">
        <RadioButton Style="{StaticResource NavItem}" Tag="PageDock" Content="Dock" ui:NavGlyph.Glyph="&#xE8A0;" IsChecked="True" Checked="OnNav" />
        <RadioButton Style="{StaticResource NavItem}" Tag="PageBar" Content="Barra superior" ui:NavGlyph.Glyph="&#xE7C4;" Checked="OnNav" />
        <RadioButton Style="{StaticResource NavItem}" Tag="PageItems" Content="Itens da barra" ui:NavGlyph.Glyph="&#xE71D;" Checked="OnNav" />
        <RadioButton Style="{StaticResource NavItem}" Tag="PageTiling" Content="Mosaico" ui:NavGlyph.Glyph="&#xF0E2;" Checked="OnNav" />
        <RadioButton Style="{StaticResource NavItem}" Tag="PageGeneral" Content="Geral" ui:NavGlyph.Glyph="&#xE713;" Checked="OnNav" />
      </StackPanel>

    <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                  Padding="8,0,18,0">
      <StackPanel>
      <StackPanel x:Name="PageDock">

        <TextBlock Text="Posição" Style="{StaticResource FluentSection}" Margin="2,0,0,8" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Borda da tela" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Nas laterais os ícones empilham na vertical"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="150" Style="{StaticResource FluentCombo}"
                      SelectedValue="{Binding Edge, Mode=TwoWay}" SelectedValuePath="Tag">
              <ComboBoxItem Content="Inferior" Tag="{x:Static interop:DockEdge.Bottom}" />
              <ComboBoxItem Content="Superior" Tag="{x:Static interop:DockEdge.Top}" />
              <ComboBoxItem Content="Esquerda" Tag="{x:Static interop:DockEdge.Left}" />
              <ComboBoxItem Content="Direita"  Tag="{x:Static interop:DockEdge.Right}" />
            </ComboBox>
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Espessura" Style="{StaticResource FluentTitle}" />
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="24" Maximum="120" Value="{Binding Size, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding Size, StringFormat='{}{0} px'}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Margens da pílula" Style="{StaticResource FluentTitle}" />
            <TextBlock Text="Folga em cada lado, em pixels"
                       Style="{StaticResource FluentCaption}" />

            <!-- os quatro lados em colunas: numa linha só, o último campo saía da janela -->
            <UniformGrid Columns="4" Margin="0,10,0,0">
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Superior" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding MarginTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Inferior" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding MarginBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Esquerda" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding MarginLeft, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Direita" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding MarginRight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Reservar a faixa" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Encolhe a área de trabalho para nada maximizado passar por baixo"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding ReserveSpace, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Centralizar a pílula" Style="{StaticResource FluentTitle}" />
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding Centered, Mode=TwoWay}" />
          </Grid>
        </Border>

        <TextBlock Text="Aparência" Style="{StaticResource FluentSection}" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Opacidade" Style="{StaticResource FluentTitle}" />
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="0" Maximum="100" Value="{Binding Opacity, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat='{}{0}%'}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Cantos" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Metade da espessura dá a cápsula perfeita"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="0" Maximum="60" Value="{Binding CornerRadius, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding CornerRadius, StringFormat='{}{0} px'}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Folga do ícone" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Menor = ícone maior dentro do botão; ignorada com tamanho fixo"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="0" Maximum="20" Value="{Binding IconPadding, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding IconPadding, StringFormat='{}{0} px'}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Folga da pílula" Style="{StaticResource FluentTitle}" />
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="0" Maximum="20" Value="{Binding PillPadding, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding PillPadding, StringFormat='{}{0} px'}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Cor de fundo" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Hex; a opacidade é aplicada em cima"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <TextBox Grid.Column="1" Style="{StaticResource FluentTextBox}"
                     Text="{Binding Background, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:ColorPicker Grid.Column="2" Margin="8,0,0,0"
                            Color="{Binding Background, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Cor do indicador" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="A bolinha do app aberto; apagada quando ele não está em foco"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <TextBox Grid.Column="1" Style="{StaticResource FluentTextBox}"
                     Text="{Binding IndicatorColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:ColorPicker Grid.Column="2" Margin="8,0,0,0"
                            Color="{Binding IndicatorColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Tamanho do ícone" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Zero deixa a dock decidir pelo tamanho do botão"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="0" Maximum="64" Value="{Binding IconSize, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FluentCaption}">
                  <Setter Property="Text" Value="{Binding IconSize, StringFormat='{}{0} px'}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IconSize}" Value="0">
                      <Setter Property="Text" Value="automático" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>

        <TextBlock Text="Comportamento" Style="{StaticResource FluentSection}" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mostrar apps abertos que não estão fixados"
                       Style="{StaticResource FluentTitle}" />
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding ShowRunning, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Abrir pela posição com Alt+número" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Alt+1 a Alt+9 acionam o botão daquela posição na dock, contando da esquerda. Não é Win+número porque essas combinações pertencem à barra de tarefas do Windows e seguem a ordem dela, não a da dock. Enquanto ligado, Alt+número deixa de chegar ao programa em foco."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding NumberHotkeys, Mode=TwoWay}" />
          </Grid>
        </Border>

      </StackPanel>

      <StackPanel x:Name="PageBar" Visibility="Collapsed">

        <TextBlock Text="Barra superior" Style="{StaticResource FluentSection}" Margin="2,0,0,8" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Barra superior" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Relógio, data e atalhos para os painéis do Windows"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding Panel, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Altura da barra superior" Style="{StaticResource FluentTitle}" />
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="22" Maximum="60" Value="{Binding PanelSize, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding PanelSize, StringFormat='{}{0} px'}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Opacidade da barra superior" Style="{StaticResource FluentTitle}" />
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="0" Maximum="100" Value="{Binding PanelOpacity, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding PanelOpacity, StringFormat='{}{0}%'}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Cor da barra superior" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Independente da cor da dock" Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <TextBox Grid.Column="1" Style="{StaticResource FluentTextBox}"
                     Text="{Binding PanelBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:ColorPicker Grid.Column="2" Margin="8,0,0,0"
                            Color="{Binding PanelBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>

        <TextBlock Text="Arranjo" Style="{StaticResource FluentSection}" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Relógio no centro" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Em vez do canto direito, ao lado dos indicadores"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding PanelCenterClock, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Barra em ilhas" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="A faixa some e ficam pílulas: o relógio numa, os ícones em outra. Para dividir os ícones em mais ilhas, marque &quot;nova ilha&quot; em Ordem dos itens da barra."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      AutomationProperties.Name="Barra em ilhas"
                      IsChecked="{Binding PanelIslands, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- as folgas das ilhas, no desenho das "Margens da pílula" da dock; só com as ilhas ligadas -->
        <Border Style="{StaticResource FluentCardBorderStyle}"
                Visibility="{Binding PanelIslands, Converter={StaticResource BoolToVisible}}">
          <StackPanel>
            <TextBlock Text="Margens das ilhas" Style="{StaticResource FluentTitle}" />
            <TextBlock Text="Folga em cada lado, em pixels. Zero em cima encosta as ilhas no topo da tela; esquerda e direita contam da borda da tela até a ilha da ponta."
                       Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />

            <UniformGrid Columns="5" Margin="0,10,0,0">
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Superior" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding IslandMarginTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Inferior" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding IslandMarginBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Esquerda" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding IslandMarginLeft, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Direita" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding IslandMarginRight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Entre ilhas" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding IslandGap, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Ícones compactos" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Os ícones da barra ficam menores (do tamanho dos de CPU e memória) e mais juntos, com metade do espaço entre eles. A barra fica mais curta."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      AutomationProperties.Name="Ícones compactos"
                      IsChecked="{Binding PanelCompact, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- A ordem dos itens da barra, nos dois cantos. A divisória é uma linha da lista como as
             outras: passar um item por ela, com as setas, é mudar o item de canto. -->
        <Border Style="{StaticResource FluentCardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Ordem dos itens da barra" Style="{StaticResource FluentTitle}" />
            <TextBlock Text="Da esquerda para a direita, como aparecem na barra. O que fica acima da divisória vai para o canto esquerdo, o que fica abaixo para o direito — use as setas para mover um item, inclusive de um canto para o outro. A barra muda na hora."
                       Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />

            <TextBlock Text="CANTO ESQUERDO" Foreground="{StaticResource FluentTextDim}" FontSize="10"
                       FontWeight="SemiBold" Margin="2,12,0,6" />

            <ItemsControl x:Name="PanelOrderList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                  <!-- a divisória: só o rótulo do canto direito, entre dois riscos -->
                  <Grid Margin="0,8,0,8"
                        Visibility="{Binding IsDivider, Converter={StaticResource BoolToVisible}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CANTO DIREITO" Foreground="{StaticResource FluentTextDim}" FontSize="10"
                               FontWeight="SemiBold" Margin="2,0,10,0" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="1" Background="{StaticResource FluentControlBorder}"
                            VerticalAlignment="Center" />
                  </Grid>

                  <Border Background="{StaticResource FluentControl}"
                          Visibility="{Binding IsItem, Converter={StaticResource BoolToVisible}}"
                          BorderBrush="{StaticResource FluentControlBorder}" BorderThickness="1"
                          CornerRadius="6" Padding="10,5" Margin="0,0,0,4">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <TextBlock Text="{Binding Position}" Foreground="{StaticResource FluentTextDim}"
                                 FontSize="11" VerticalAlignment="Center" Width="20" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12"
                                   Foreground="{StaticResource FluentText}" VerticalAlignment="Center" />

                        <!-- em ilhas: a ilha nova começa neste item. O primeiro sempre abre uma,
                             então ele não ganha a caixa -->
                        <CheckBox Content="nova ilha" FontSize="11" Margin="12,0,0,0"
                                  Foreground="{StaticResource FluentTextDim}" VerticalAlignment="Center"
                                  IsChecked="{Binding StartsIsland, Mode=OneWay}" Tag="{Binding Key}"
                                  Checked="OnIslandBreak" Unchecked="OnIslandBreak">
                          <CheckBox.Style>
                            <Style TargetType="CheckBox">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.PanelIslands, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    <Condition Binding="{Binding IsFirst}" Value="False" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </CheckBox.Style>
                        </CheckBox>
                      </StackPanel>

                      <Button Grid.Column="2" Style="{StaticResource FluentButton}" Padding="8,2"
                              Click="OnPanelItemUp" Tag="{Binding Key}" ToolTip="Mover para a esquerda">
                        <TextBlock Text="&#x2191;" FontSize="12" />
                      </Button>
                      <Button Grid.Column="3" Style="{StaticResource FluentButton}" Padding="8,2"
                              Margin="4,0,0,0" Click="OnPanelItemDown" Tag="{Binding Key}"
                              ToolTip="Mover para a direita">
                        <TextBlock Text="&#x2193;" FontSize="12" />
                      </Button>
                    </Grid>
                  </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource FluentButton}" HorizontalAlignment="Left"
                    Margin="0,6,0,0" Click="OnResetPanelOrder" Content="Voltar à ordem padrão" />
          </StackPanel>
        </Border>

      </StackPanel>

      <StackPanel x:Name="PageItems" Visibility="Collapsed">

        <TextBlock Text="Busca e locais" Style="{StaticResource FluentSection}" Margin="2,0,0,8" />

        <!-- A lupa e onde a busca aparece quando aberta por ela -->
        <Border Style="{StaticResource FluentCardBorderStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Busca" Style="{StaticResource FluentTitle}" />
                <TextBlock Text="Uma lupa na barra que abre a busca de aplicativos — a mesma do Alt+Espaço."
                           Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                        AutomationProperties.Name="Busca"
                        IsChecked="{Binding PanelSearch, Mode=TwoWay}" />
            </Grid>

            <!-- onde a busca aberta pela lupa aparece; o Alt+Espaço fica sempre no meio -->
            <Grid Margin="0,12,0,0"
                  Visibility="{Binding PanelSearch, Converter={StaticResource BoolToVisible}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Onde a busca aparece" Style="{StaticResource FluentTitle}" />
                <TextBlock Text="Ao clicar na lupa. Compacta: logo abaixo dela, mais estreita. O Alt+Espaço continua abrindo no meio da tela."
                           Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox Grid.Column="1" Width="190" Style="{StaticResource FluentCombo}"
                        SelectedValue="{Binding SearchStyle, Mode=TwoWay}" SelectedValuePath="Tag">
                <ComboBoxItem Content="No meio da tela" Tag="{x:Static services:SearchStyle.Center}" />
                <ComboBoxItem Content="Compacta, abaixo da lupa" Tag="{x:Static services:SearchStyle.Button}" />
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Os locais: a mesma lista apertada das ferramentas, com a pasta no lugar do comando -->
        <Border x:Name="PlacesCard" Style="{StaticResource FluentCardBorderStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Locais" Style="{StaticResource FluentTitle}" />
                <TextBlock Text="Um botão &quot;Locais&quot; na barra com as pastas que você mais usa, abertas no Explorador. Vale pasta de rede (\\servidor\pasta) e variável (%USERPROFILE%\Projetos)."
                           Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                        AutomationProperties.Name="Locais"
                        IsChecked="{Binding PanelPlaces, Mode=TwoWay}" />
            </Grid>

            <StackPanel Visibility="{Binding PanelPlaces, Converter={StaticResource BoolToVisible}}">
              <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="38" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Nome" Style="{StaticResource FluentCaption}" />
                <TextBlock Grid.Column="2" Text="Pasta" Style="{StaticResource FluentCaption}" Margin="6,0,0,0" />
              </Grid>

              <ItemsControl x:Name="PlacesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="38" />
                          <ColumnDefinition Width="160" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:GlyphPicker Tool="{Binding}" HorizontalAlignment="Left" />
                        <TextBox Grid.Column="1" Style="{StaticResource FluentTextBox}" FontSize="12" Height="28"
                                 TextAlignment="Left" Padding="4,0"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="OnPlaceEdited" />
                        <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" FontSize="12"
                                 Height="28" Margin="6,0,0,0" Padding="4,0"
                                 FontFamily="Cascadia Mono, Consolas"
                                 Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="OnPlaceEdited" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                          <Button Style="{StaticResource FluentButton}" Padding="7,1" Height="28"
                                  Click="OnPlaceBrowse" Tag="{Binding}" ToolTip="Escolher a pasta">
                            <TextBlock Text="&#x2026;" FontSize="11" />
                          </Button>
                          <Button Style="{StaticResource FluentButton}" Padding="7,1" Height="28" Margin="3,0,0,0"
                                  Click="OnPlaceUp" Tag="{Binding}" ToolTip="Subir">
                            <TextBlock Text="&#x2191;" FontSize="11" />
                          </Button>
                          <Button Style="{StaticResource FluentButton}" Padding="7,1" Height="28" Margin="3,0,0,0"
                                  Click="OnPlaceRemove" Tag="{Binding}" ToolTip="Tirar da lista">
                            <TextBlock Text="&#x2715;" FontSize="11" />
                          </Button>
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="{Binding Problem}" Foreground="#FFFFB86C" FontSize="11"
                                 Margin="44,3,0,2" TextWrapping="Wrap"
                                 Visibility="{Binding Problem, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Style="{StaticResource FluentButton}" Click="OnPlaceAdd" Content="Adicionar pasta" />
                <Button Style="{StaticResource FluentButton}" Click="OnPlacesDefaults" Margin="8,0,0,0"
                        Content="Repor as pastas do usuário" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="Relógio e calendário" Style="{StaticResource FluentSection}" />

        <!-- uma lista, e não um controle deslizante: a limpeza roda assim que o prazo muda, e
             arrastar de 30 até "Nunca" passaria por 1 dia no caminho, apagando tarefas no meio -->
        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="Apagar tarefas concluídas" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="As do calendário, contando de quando foram marcadas como feitas"
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="150" Style="{StaticResource FluentCombo}"
                      SelectedValue="{Binding CalendarDoneRetentionDays, Mode=TwoWay}" SelectedValuePath="Tag">
              <ComboBoxItem Content="Nunca"><ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
              <ComboBoxItem Content="Depois de 1 dia"><ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
              <ComboBoxItem Content="Depois de 2 dias"><ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
              <ComboBoxItem Content="Depois de 3 dias"><ComboBoxItem.Tag><sys:Int32>3</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
              <ComboBoxItem Content="Depois de 7 dias"><ComboBoxItem.Tag><sys:Int32>7</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
              <ComboBoxItem Content="Depois de 15 dias"><ComboBoxItem.Tag><sys:Int32>15</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
              <ComboBoxItem Content="Depois de 30 dias"><ComboBoxItem.Tag><sys:Int32>30</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
            </ComboBox>
          </Grid>
        </Border>

        <TextBlock Text="Bandeja e som" Style="{StaticResource FluentSection}" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Ícones da bandeja" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Mostra os ícones dos programas rodando em segundo plano — antivírus, AnyDesk e afins"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding PanelTray, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- Batizar os ícones que não têm nome. Alguns programas não publicam dica de mouse,
             e para esses não há texto em lugar nenhum: nem na automação, nem no registro do
             Windows. O apelido é guardado pelo desenho do ícone, que é a única coisa que
             distingue um do outro. O cartão inteiro só aparece quando existe algum assim. -->
        <Border x:Name="TrayNamesCard" Style="{StaticResource FluentCardBorderStyle}"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Ícones sem nome" Style="{StaticResource FluentTitle}" />
            <TextBlock Text="Estes programas não informam o próprio nome ao Windows. Dê um apelido para reconhecê-los na barra."
                       Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />

            <ItemsControl x:Name="TrayNamesList" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- o desenho, que é como a pessoa reconhece de qual programa se trata -->
                    <Border Background="{StaticResource FluentControl}"
                            BorderBrush="{StaticResource FluentControlBorder}" BorderThickness="1"
                            CornerRadius="6" Width="34" Height="34" VerticalAlignment="Center">
                      <Image Source="{Binding Image}" Width="20" Height="20"
                             RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Suggestion}" VerticalAlignment="Center"
                               Margin="10,0,0,0" Width="150" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource FluentTextDim}" FontSize="12"
                               ToolTip="Programas rodando agora que têm ícone de bandeja e nome desconhecido" />

                    <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" Margin="10,0,0,0"
                             Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding Signature}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Volume por aplicativo" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Um controle para cada programa com som, dentro do painel de volume"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding PanelAppVolume, Mode=TwoWay}" />
          </Grid>
        </Border>

        <TextBlock Text="Música" Style="{StaticResource FluentSection}" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Controles de mídia" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="O que está tocando e os botões de reprodução na barra — vale para qualquer programa (Spotify, navegador, VLC). Some sozinho quando não há mídia."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding PanelMedia, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- só faz sentido com a barra de mídia ligada, e some junto com ela -->
        <Border Style="{StaticResource FluentCardBorderStyle}"
                Visibility="{Binding PanelMedia, Converter={StaticResource BoolToVisible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Rolar o nome da faixa" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Nome comprido demais para a barra passa rolando, em vez de terminar em reticências. Rola só o que não cabe, e só enquanto está tocando — em pausa, para."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      AutomationProperties.Name="Rolar o nome da faixa"
                      IsChecked="{Binding PanelMediaTicker, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- Quais programas podem ocupar a barra de mídia. Nenhum marcado = todos, que é o
             comportamento de quem nunca abriu esta seção. -->
        <Border x:Name="MediaAppsCard" Style="{StaticResource FluentCardBorderStyle}"
                Visibility="{Binding PanelMedia, Converter={StaticResource BoolToVisible}}">
          <StackPanel>
            <TextBlock Text="Programas na barra de mídia" Style="{StaticResource FluentTitle}" />
            <TextBlock Text="Marque quem pode ocupar a barra. Sem nenhum marcado, vale para todos — marque só o Spotify se não quiser que um vídeo no navegador tome o lugar dele."
                       Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />

            <ItemsControl x:Name="MediaAppsList" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Name}" Margin="0,0,0,6"
                            Foreground="{StaticResource FluentText}" FontSize="12"
                            IsChecked="{Binding Allowed, Mode=TwoWay}"
                            ToolTip="{Binding AppId}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="MediaAppsEmpty" Style="{StaticResource FluentCaption}"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Nenhum programa de mídia visto ainda. Dê play em algo — no Spotify, ou num vídeo do navegador — e o programa aparece aqui assim que você voltar para esta janela." />
          </StackPanel>
        </Border>

        <TextBlock Text="Ferramentas" Style="{StaticResource FluentSection}" />

        <!-- O botão de ferramentas e a lista dele. Linhas apertadas, como o próprio cartão da
             barra: nome à esquerda, o comando como se digitado no Executar (Win+R) à direita. -->
        <Border x:Name="ToolsCard" Style="{StaticResource FluentCardBorderStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ferramentas" Style="{StaticResource FluentTitle}" />
                <TextBlock Text="Uma chave de boca na barra com os comandos que você mais usa. O comando é o mesmo que se digita no Executar (Win+R): devmgmt.msc, control inetcpl.cpl, mstsc /v:servidor."
                           Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                        AutomationProperties.Name="Ferramentas"
                        IsChecked="{Binding PanelTools, Mode=TwoWay}" />
            </Grid>

            <StackPanel Visibility="{Binding PanelTools, Converter={StaticResource BoolToVisible}}">
              <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="38" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Nome" Style="{StaticResource FluentCaption}" />
                <TextBlock Grid.Column="2" Text="Comando" Style="{StaticResource FluentCaption}" Margin="6,0,0,0" />
              </Grid>

              <ItemsControl x:Name="ToolsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="38" />
                          <ColumnDefinition Width="160" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- o desenho do cartão: automático pelo comando, ou o escolhido aqui -->
                        <ui:GlyphPicker Tool="{Binding}" HorizontalAlignment="Left" />
                        <TextBox Grid.Column="1" Style="{StaticResource FluentTextBox}" FontSize="12" Height="28"
                                 TextAlignment="Left" Padding="4,0"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="OnToolEdited" />
                        <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" FontSize="12"
                                 Height="28" Margin="6,0,0,0" Padding="4,0"
                                 FontFamily="Cascadia Mono, Consolas"
                                 Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="OnToolEdited" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                          <Button Style="{StaticResource FluentButton}" Padding="7,1" Height="28"
                                  Click="OnToolBrowse" Tag="{Binding}" ToolTip="Procurar o programa">
                            <TextBlock Text="&#x2026;" FontSize="11" />
                          </Button>
                          <Button Style="{StaticResource FluentButton}" Padding="7,1" Height="28" Margin="3,0,0,0"
                                  Click="OnToolUp" Tag="{Binding}" ToolTip="Subir">
                            <TextBlock Text="&#x2191;" FontSize="11" />
                          </Button>
                          <Button Style="{StaticResource FluentButton}" Padding="7,1" Height="28" Margin="3,0,0,0"
                                  Click="OnToolRemove" Tag="{Binding}" ToolTip="Tirar da lista">
                            <TextBlock Text="&#x2715;" FontSize="11" />
                          </Button>
                        </StackPanel>
                      </Grid>

                      <!-- o comando que não vai abrir avisa aqui, enquanto se digita, e não só no clique -->
                      <TextBlock Text="{Binding Problem}" Foreground="#FFFFB86C" FontSize="11"
                                 Margin="44,3,0,2" TextWrapping="Wrap"
                                 Visibility="{Binding Problem, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Style="{StaticResource FluentButton}" Click="OnToolAdd" Content="Adicionar comando" />
                <Button Style="{StaticResource FluentButton}" Click="OnToolsDefaults" Margin="8,0,0,0"
                        Content="Repor os exemplos" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="Notificações" Style="{StaticResource FluentSection}" />

        <!-- O balão breve quando chega uma notificação: ligado, o tempo e se mostra o texto -->
        <Border Style="{StaticResource FluentCardBorderStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Balão ao chegar" Style="{StaticResource FluentTitle}" />
                <TextBlock Text="Um balão breve embaixo do sino quando chega uma notificação nova, com o desenho da origem. O clique leva ao app ou à aba que mandou; com o mouse em cima ele espera. Se a faixa do próprio Windows também estiver ligada, as duas aparecem — desligue uma (a do Windows fica em Configurações › Sistema › Notificações)."
                           Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                        AutomationProperties.Name="Balão ao chegar"
                        IsChecked="{Binding NotificationPopup, Mode=TwoWay}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding NotificationPopup, Converter={StaticResource BoolToVisible}}">
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Segundos na tela" Style="{StaticResource FluentCaption}" Margin="2,0,0,4" />
                <TextBox Style="{StaticResource FluentTextBox}" Width="70" HorizontalAlignment="Left"
                         Text="{Binding NotificationPopupSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <CheckBox Content="Mostrar o texto da mensagem" VerticalAlignment="Bottom" Margin="0,0,0,6"
                        Foreground="{StaticResource FluentText}" FontSize="12"
                        ToolTip="Desmarcado, o balão diz só de onde veio — para quando outra pessoa pode estar vendo a tela"
                        IsChecked="{Binding NotificationPopupText, Mode=TwoWay}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Cada origem: o desenho no cartão, se entra no sino e se ganha balão. A lista se
             preenche sozinha com o que aparece na Central; o que chega pelo navegador vem pelo
             site, e não como "Chrome". -->
        <Border Style="{StaticResource FluentCardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Origens" Style="{StaticResource FluentTitle}" />
            <TextBlock Text="Cada app ou site que já mandou notificação. O desenho é o do cartão do sino; desmarcar &quot;no sino&quot; tira a origem do número e do cartão (ela continua na Central do Windows), e &quot;balão&quot; decide se ela ganha o balão breve. Origens novas entram aqui sozinhas na primeira notificação; no automático, os sites conhecidos têm o desenho deles e o resto usa o ícone do app."
                       Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />

            <ItemsControl x:Name="NotificationSourcesList" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38" />
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:GlyphPicker Tool="{Binding}" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource FluentTitle}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Key}" Style="{StaticResource FluentCaption}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="6,0,0,0"
                               ToolTip="{Binding Key}" />
                    <CheckBox Grid.Column="3" Content="no sino" FontSize="11" Margin="10,0,0,0"
                              Foreground="{StaticResource FluentTextDim}" VerticalAlignment="Center"
                              ToolTip="Conta no número do sino e aparece no cartão"
                              IsChecked="{Binding Show, Mode=TwoWay}" />
                    <CheckBox Grid.Column="4" Content="balão" FontSize="11" Margin="10,0,0,0"
                              Foreground="{StaticResource FluentTextDim}" VerticalAlignment="Center"
                              ToolTip="Ganha o balão breve quando chega"
                              IsChecked="{Binding Popup, Mode=TwoWay}"
                              IsEnabled="{Binding Show}" />
                    <Button Grid.Column="5" Style="{StaticResource FluentButton}" Padding="7,1" Height="28"
                            Margin="10,0,0,0" Click="OnNotificationSourceRemove" Tag="{Binding}"
                            ToolTip="Tirar da lista (volta se chegar outra notificação dela)">
                      <TextBlock Text="&#x2715;" FontSize="11" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="Sistema" Style="{StaticResource FluentSection}" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="CPU e memória" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Quanto do processador e da memória estão em uso, em porcentagem. O clique abre o cartão com o último minuto de processador, memória, placa de vídeo e rede em gráfico. A medida vem do kernel uma vez por segundo — não pesa na máquina que ela mede."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      AutomationProperties.Name="CPU e memória"
                      IsChecked="{Binding PanelSystem, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Indicador de brilho" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="O controle de brilho do monitor na barra. Some sozinho num monitor que não fala DDC/CI — o painel do notebook, em geral."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding PanelBrightness, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Remover dispositivo externo" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Um botão na barra para remover pen-drive e HD externo com segurança, pela mesma via do &quot;Remover hardware&quot; do Windows. Só existe enquanto houver algum dispositivo externo conectado."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      AutomationProperties.Name="Remover dispositivo externo"
                      IsChecked="{Binding PanelRemovable, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Atualizações esperando" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Um ícone na barra para o que há para atualizar, do Windows Update e do winget: aceso e com o número quando há algo esperando, apagado quando está tudo em dia. A lista fica no cartão, e nada é instalado por aqui — ele leva você ao Windows Update ou abre um terminal com o comando do winget pronto. Desligue se não quiser o ícone na barra."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      AutomationProperties.Name="Atualizações esperando"
                      IsChecked="{Binding PanelUpdates, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Avisar nova versão do WinDock" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Um presente aparece à esquerda das atualizações quando sai uma versão nova no GitHub. O clique baixa, troca e reabre a dock. O GitHub é consultado uma vez por dia."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      AutomationProperties.Name="Avisar nova versão do WinDock"
                      IsChecked="{Binding PanelSelfUpdate, Mode=TwoWay}" />
          </Grid>
        </Border>

        <TextBlock Text="Cota de IA" Style="{StaticResource FluentSection}" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Cota de IA" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Quanto da cota do Claude já foi usada, num cartão da barra: a janela de 5 horas, a da semana e quando cada uma zera. Só aparece se você usa o Claude Code nesta máquina; os números vêm da mesma fonte do /usage dele."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      AutomationProperties.Name="Cota de IA"
                      IsChecked="{Binding PanelAiUsage, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- As contas do Claude Code encontradas na máquina. Com uma conta só não há o que
             escolher, e este cartão nem aparece: quem o mostra é o LoadAiAccounts. -->
        <Border x:Name="AiAccountsCard" Style="{StaticResource FluentCardBorderStyle}"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Contas no cartão de cota" Style="{StaticResource FluentTitle}" />
            <TextBlock Text="Você tem mais de uma conta do Claude Code nesta máquina. Marque as que o cartão deve mostrar, uma embaixo da outra. Sem nenhuma marcada, ele mostra todas."
                       Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />

            <ItemsControl x:Name="AiAccountList" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource FluentControl}"
                          BorderBrush="{StaticResource FluentControlBorder}" BorderThickness="1"
                          CornerRadius="6" Padding="10,7" Margin="0,0,0,4">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Titulo}" FontSize="12"
                                   Foreground="{StaticResource FluentText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detalhe}" FontSize="11"
                                   Foreground="{StaticResource FluentTextDim}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                                AutomationProperties.Name="{Binding Titulo}"
                                Tag="{Binding Id}" IsChecked="{Binding Marcada, Mode=TwoWay}"
                                Checked="OnAiAccountToggled" Unchecked="OnAiAccountToggled" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>

      <StackPanel x:Name="PageTiling" Visibility="Collapsed">

        <TextBlock Text="Mosaico" Style="{StaticResource FluentSection}" Margin="2,0,0,8" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Ligado" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Divide as janelas de cada monitor sem sobrepor — os atalhos ficam logo abaixo"
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding TilingEnabled, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Abrir flutuando" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Toda janela nova nasce fora do mosaico, centralizada, no tamanho guardado do programa — dividir a tela passa a ser o atalho de flutuar, que devolve a janela ao grid"
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding TilingFloatNewWindows, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- atalhos: uma linha por ação, montada no código a partir do HotkeyCatalog -->
        <Border Style="{StaticResource FluentCardBorderStyle}" MinHeight="0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Atalhos" Style="{StaticResource FluentTitle}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Restaurar padrão" Style="{StaticResource FluentButton}"
                      Click="OnResetHotkeys" />
            </Grid>
            <TextBlock Text="Valem para o sistema inteiro: a combinação escolhida deixa de chegar aos outros programas enquanto a dock está aberta. Escolher a combinação de outra ação troca as duas de lugar"
                       Style="{StaticResource FluentCaption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ItemsControl x:Name="HotkeysList" Margin="0,4,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource FluentText}" FontSize="13" />
                      <TextBlock Text="{Binding Caption}" Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <ComboBox Width="150" Style="{StaticResource FluentCombo}"
                                ItemsSource="{Binding Modifiers}" SelectedItem="{Binding Modifier, Mode=TwoWay}" />
                      <TextBlock Text="+ setas" Width="64" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Style="{StaticResource FluentCaption}"
                                 Visibility="{Binding Arrows, Converter={StaticResource BoolToVisible}}" />
                      <ComboBox Width="64" Margin="8,0,0,0" Style="{StaticResource FluentCombo}" MaxDropDownHeight="300"
                                Visibility="{Binding HasKey, Converter={StaticResource BoolToVisible}}"
                                IsEnabled="{Binding KeyEnabled}"
                                ItemsSource="{Binding Letters}" SelectedItem="{Binding Letter, Mode=TwoWay}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}" MinHeight="0">
          <StackPanel>
            <TextBlock Text="Exceções" Style="{StaticResource FluentTitle}" />
            <TextBlock Text="Apps com tamanho pensado pra ser aquele — não entram no mosaico sozinhos ao abrir, mas continuam alcançáveis pelo atalho de flutuar. Nome do .exe, o AppUserModelID (Calculadora, Configurações) ou classe:NomeDaClasse para uma janela específica de um app, como a caixa de progresso do Explorer"
                       Style="{StaticResource FluentCaption}" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ExcludedAppBox" Style="{StaticResource FluentTextBox}"
                       KeyDown="OnExcludedAppKeyDown" />
              <Button Grid.Column="1" Content="Adicionar" Style="{StaticResource FluentButton}"
                      Margin="8,0,0,0" Click="OnAddExcludedApp" />
            </Grid>
            <ItemsControl x:Name="ExcludedAppsList" Margin="0,10,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource FluentControl}" BorderBrush="{StaticResource FluentControlBorder}"
                          BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding}" Foreground="{StaticResource FluentText}" FontSize="12"
                                 VerticalAlignment="Center" />
                      <TextBlock Text=" ✕" Foreground="{StaticResource FluentTextDim}" FontSize="12"
                                 Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                 MouseLeftButtonUp="OnRemoveExcludedApp" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}" MinHeight="0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Tamanho das janelas flutuantes" Style="{StaticResource FluentTitle}" />
              <Button Grid.Column="1" Content="Esquecer todos" Style="{StaticResource FluentButton}"
                      Click="OnClearFloatingSizes" />
            </Grid>
            <TextBlock Text="Redimensionar uma janela flutuante guarda aquele tamanho para o programa, e as próximas nascem assim, centralizadas. Esquecer um devolve ele aos 60% da tela — o atalho “Esquecer tamanho” faz o mesmo na janela em foco"
                       Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            <ItemsControl x:Name="FloatingSizesList" Margin="0,10,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource FluentControl}" BorderBrush="{StaticResource FluentControlBorder}"
                          BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding App}" Foreground="{StaticResource FluentText}" FontSize="12"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Size}" Foreground="{StaticResource FluentTextDim}" FontSize="12"
                                 Margin="6,0,0,0" VerticalAlignment="Center" />
                      <TextBlock Text=" ✕" Foreground="{StaticResource FluentTextDim}" FontSize="12"
                                 Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                 MouseLeftButtonUp="OnRemoveFloatingSize" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="FloatingSizesEmpty" Margin="0,8,0,0"
                       Text="Nenhum tamanho guardado ainda — todo programa abre flutuando com 60% da tela."
                       Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Espaçamento" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Folga entre as janelas e a borda da tela"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="0" Maximum="60" Value="{Binding TilingGap, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding TilingGap, StringFormat='{}{0} px'}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Passo do redimensionamento" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Quanto cada toque do atalho de redimensionar tira da janela vizinha"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}"
                    Minimum="1" Maximum="200" Value="{Binding TilingResizeStep, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding TilingResizeStep, StringFormat='{}{0} px'}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Cor da borda" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="A própria borda nativa do Windows 11 em volta da janela em foco, recolorida; hex"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <TextBox Grid.Column="1" Style="{StaticResource FluentTextBox}"
                     Text="{Binding TilingBorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:ColorPicker Grid.Column="2" Margin="8,0,0,0"
                            Color="{Binding TilingBorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Contorno" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Desliga só o realce de foco, sem desligar o mosaico — espessura e cantos são do próprio Windows, não dá pra ajustar"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding TilingBorderThickness, Mode=TwoWay, Converter={StaticResource IntToBool}}" />
          </Grid>
        </Border>

      </StackPanel>

      <StackPanel x:Name="PageGeneral" Visibility="Collapsed">

        <TextBlock Text="Geral" Style="{StaticResource FluentSection}" Margin="2,0,0,8" />

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Barra do Windows" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Escondida, o menu iniciar vira o Alt+Espaço"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="190" Style="{StaticResource FluentCombo}"
                      SelectedValue="{Binding Taskbar, Mode=TwoWay}" SelectedValuePath="Tag">
              <ComboBoxItem Content="Não mexer" Tag="{x:Static services:TaskbarMode.Keep}" />
              <ComboBoxItem Content="Recolher na borda" Tag="{x:Static services:TaskbarMode.AutoHide}" />
              <ComboBoxItem Content="Esconder" Tag="{x:Static services:TaskbarMode.Hidden}" />
            </ComboBox>
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Buscar aplicativos com Alt+Espaço" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Apps instalados, comandos e desligar/reiniciar"
                         Style="{StaticResource FluentCaption}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      IsChecked="{Binding Launcher, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- só faz sentido com a busca ligada -->
        <Border Style="{StaticResource FluentCardBorderStyle}"
                Visibility="{Binding Launcher, Converter={StaticResource BoolToVisible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Resultados na busca" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Quantos aplicativos a lista mostra. A linha para executar um comando aparece sempre, além destes."
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource FluentSlider}" VerticalAlignment="Center"
                    Minimum="3" Maximum="20" Value="{Binding LauncherResults, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding LauncherResults}"
                       Style="{StaticResource FluentCaption}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Iniciar com o Windows" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Cria uma tarefa de logon, que sobe a dock assim que a sessão abre — sem esperar a fila dos aplicativos de inicialização"
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox x:Name="StartupBox" Grid.Column="1" Style="{StaticResource FluentToggle}"
                      Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
          </Grid>
        </Border>

        <Border Style="{StaticResource FluentCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Registrar cada passo no log" Style="{StaticResource FluentTitle}" />
              <TextBlock Text="Para investigar algum problema. Deixa a dock mais lenta quando o disco está ocupado — cada passo é uma escrita — então convém desligar depois. O log fica em %APPDATA%\WinDock"
                         Style="{StaticResource FluentCaption}" TextWrapping="Wrap" />
            </StackPanel>
            <!-- o rótulo vive num TextBlock ao lado, então sem isto o interruptor chega sem nome
                 a quem usa leitor de tela (e a quem o aciona de fora, para testar) -->
            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggle}"
                      AutomationProperties.Name="Registrar cada passo no log"
                      IsChecked="{Binding Trace, Mode=TwoWay}" />
          </Grid>
        </Border>

      </StackPanel>

      </StackPanel>
    </ScrollViewer>
    </Grid>

    <!-- ── rodape ────────────────────────────────────────── -->
    <Border Grid.Row="2" BorderBrush="{StaticResource FluentDivider}" BorderThickness="0,1,0,0"
            Padding="24,14">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Restaurar padrões" Click="OnReset" Style="{StaticResource FluentButton}"
                  Margin="0,0,8,0" />
