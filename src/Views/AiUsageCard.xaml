<UserControl x:Class="WinDock.Views.AiUsageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinDock.Ui">

  <!-- O conteúdo do cartão mora aqui, e não dentro do PanelWindow, por dois motivos: o
       arquivo de lá já passa de mil linhas, e um cartão isolado pode ser montado sozinho
       num harness e conferido de olho — foi assim que o espaçamento deste foi ajustado,
       sem precisar clicar na barra da pessoa. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <ui:BoolToCollapsed x:Key="BoolToCollapsed" />
    <ui:UsageBrush x:Key="UsageBrush" />
    <ui:ResetText x:Key="ResetText" />
    <ui:EmptyToCollapsed x:Key="EmptyToCollapsed" />
  </UserControl.Resources>

  <Border Background="#F7242424" BorderBrush="#2EFFFFFF" BorderThickness="1"
          CornerRadius="10" Padding="16,14" Margin="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="Black" />
    </Border.Effect>
    <StackPanel Width="280">

      <!-- Mesmo cabeçalho dos cartões de volume e bluetooth, para os três combinarem — com o
           nome de quem está logado no lugar de um título fixo: a cota é de uma conta, e quem
           tem mais de uma precisa ver de qual. O plano fica à direita, onde o cartão de
           volume põe a porcentagem. -->
      <!-- Três colunas, e não um StackPanel: dentro de um StackPanel horizontal o nome
           recebe largura infinita na medição, o `TextTrimming` nunca entra e o texto fica
           cortado a seco contra a cápsula do plano, sem as reticências que avisam que há
           mais. Na coluna `*` ele recebe o que sobra e trunca como deve. -->
      <Grid Margin="0,0,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:GlyphIcon Glyph="{Binding AiGlyph}" Fill="#FFF2F2F2" Size="17"
                      VerticalAlignment="Center" Margin="0,0,9,0" />

        <TextBlock Grid.Column="1" Text="{Binding AiAccountName}" Foreground="#FFF2F2F2"
                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

        <!-- a cápsula do plano: o mesmo realce das barras, em fundo lavado -->
        <Border Grid.Column="2" VerticalAlignment="Center"
                Background="#284CC2FF" CornerRadius="9" Padding="8,2"
                Visibility="{Binding AiPlan, Converter={StaticResource EmptyToCollapsed}}">
          <TextBlock Text="{Binding AiPlan}" Foreground="#FF4CC2FF" FontSize="11"
                     FontWeight="SemiBold" />
        </Border>
      </Grid>

      <!-- conta e organização, alinhadas com o nome (o glifo ocupa os 26 px da esquerda) -->
      <TextBlock Text="{Binding AiAccountLine}" Foreground="#FF9D9D9D" FontSize="11"
                 TextTrimming="CharacterEllipsis" Margin="26,0,0,14"
                 Visibility="{Binding AiAccountLine, Converter={StaticResource EmptyToCollapsed}}" />

      <!-- Sem medidor não há o que desenhar: fica o motivo, em uma linha. É o caminho de quem
           não entrou no Claude Code, de quem está com a sessão vencida e de quando a rede não
           responde. -->
      <TextBlock Text="{Binding AiMessage}" Foreground="#FF9D9D9D" FontSize="12"
                 TextWrapping="Wrap" Margin="0,0,0,2"
                 Visibility="{Binding HasAiMessage, Converter={StaticResource BoolToVisible}}" />

      <ItemsControl ItemsSource="{Binding AiGauges}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,13">
              <Grid Margin="0,0,0,6">
                <TextBlock Text="{Binding Nome}" Foreground="#FFE8E8EA" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,44,0" />
                <TextBlock Text="{Binding Percent, StringFormat='{}{0:0}%'}"
                           HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                           Foreground="{Binding Percent, Converter={StaticResource UsageBrush}}" />
              </Grid>

              <!-- a cápsula: trilho por baixo, preenchimento por cima. O preenchimento é
                   dimensionado no código (OnGaugeSizeChanged), porque a largura em pixels de
                   uma porcentagem só existe depois do layout. -->
              <Border Height="6" CornerRadius="3" Background="#28FFFFFF"
                      SizeChanged="OnGaugeSizeChanged">
                <Border Height="6" CornerRadius="3" Width="0" HorizontalAlignment="Left"
                        Background="{Binding Percent, Converter={StaticResource UsageBrush}}" />
              </Border>

              <TextBlock Text="{Binding ResetaEm, Converter={StaticResource ResetText}}"
                         Foreground="#FF9D9D9D" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Foreground="#FF6E6E6E" FontSize="10" Margin="0,1,0,0"
                 Text="{Binding AiUsage.Quando, StringFormat='atualizado às {0:HH:mm}'}"
                 Visibility="{Binding HasAiMessage, Converter={StaticResource BoolToCollapsed}}" />
    </StackPanel>
  </Border>
</UserControl>
